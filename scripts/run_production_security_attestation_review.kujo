from src.common import bool_or, dict_get_or, num_or, read_json_file_or, str_or, write_json_file

func ensure_dir(path_value) {
	if path_value == "" || path_value == "." || path_exists(path_value) {
		return true
	}
	parent := dirname(path_value)
	if parent != "" && parent != "." && parent != path_value {
		_ = ensure_dir(parent)
	}
	create_dir(path_value)
	return true
}

func normalize_text(value) {
	return trim(str_or(value, ""))
}

func add_blocker(blockers, code, message) {
	return push(blockers, {"code": code, "message": message})
}

func valid_sha256(value) {
	return to_bool(regex_match(to_lower(normalize_text(value)), "^[a-f0-9]{64}$"))
}

func evidence_review(raw_items, evidence_root) {
	items := []
	blockers := []
	if type(raw_items) != "array" || len(raw_items) == 0 {
		return {"ok": false, "items": items, "blockers": add_blocker(blockers, "evidence_required", "At least one evidence artifact is required.")}
	}

	root_absolute := regex_replace(path_absolute(evidence_root), "\\\\", "/")
	root_prefix := root_absolute + "/"
	for raw_item in raw_items {
		path_value := normalize_text(dict_get_or(raw_item, "path", ""))
		expected_sha256 := to_lower(normalize_text(dict_get_or(raw_item, "sha256", "")))
		path_abs := ""
		inside_root := false
		exists := false
		digest_matches := false
		if path_value != "" {
			path_abs = regex_replace(path_absolute(path_value), "\\\\", "/")
			inside_root = starts_with(path_abs, root_prefix)
			exists = inside_root && file_exists(path_abs)
			if exists && valid_sha256(expected_sha256) {
				digest_matches = to_lower(to_string(sha256_file(path_abs))) == expected_sha256
			}
		}
		item_ok := path_value != "" && inside_root && exists && valid_sha256(expected_sha256) && digest_matches
		items = push(items, {"path": path_value, "inside_evidence_root": inside_root, "exists": exists, "digest_matches": digest_matches, "ok": item_ok})
		if item_ok == false {
			blockers = add_blocker(blockers, "invalid_evidence", "Evidence must exist under the configured evidence root and match its recorded SHA-256 digest: " + path_value)
		}
	}
	return {"ok": len(blockers) == 0, "items": items, "blockers": blockers}
}

attestation_path := env_or("KUJO_RAG_PRODUCTION_ATTESTATION_PATH", "./config/production_security_attestation.template.json")
output_path := env_or("KUJO_RAG_PRODUCTION_ATTESTATION_OUTPUT_PATH", "./results/security/production_security_attestation_status.json")
evidence_root := env_or("KUJO_RAG_PRODUCTION_EVIDENCE_ROOT", "./evidence/production-security")
require_approved := true

_ = ensure_dir(dirname(output_path))
raw := read_json_file_or(attestation_path, {})
blockers := []

version := normalize_text(dict_get_or(raw, "version", ""))
environment_id := normalize_text(dict_get_or(raw, "environment_id", ""))
release := dict_get_or(raw, "release", {})
proxy := dict_get_or(raw, "proxy", {})
audit_sink := dict_get_or(raw, "audit_sink", {})
approvals := dict_get_or(raw, "approvals", {})

if version != "kujo-rag-production-security-attestation-v1" {
	blockers = add_blocker(blockers, "invalid_version", "Attestation version must be kujo-rag-production-security-attestation-v1.")
}

raw_source_text := to_lower(read_file(attestation_path))
raw_source_text = regex_replace(raw_source_text, "proxy_secret_from_secret_manager", "")
raw_source_text = regex_replace(raw_source_text, "append_only_writer_credentials", "")
secret_material_detected := false
for forbidden_key in ["secret_value", "private_key", "access_token", "api_token", "credentials"] {
	if len(split(raw_source_text, forbidden_key)) > 1 {
		secret_material_detected = true
	}
}
if secret_material_detected {
	blockers = add_blocker(blockers, "secret_material_forbidden", "Attestations must reference a secret manager and must not contain secret material.")
}
unknown_top_level_detected := false
for actual_key in keys(raw) {
	if actual_key != "version" && actual_key != "environment_id" && actual_key != "release" && actual_key != "proxy" && actual_key != "audit_sink" && actual_key != "approvals" {
		unknown_top_level_detected = true
	}
}
if unknown_top_level_detected {
	blockers = add_blocker(blockers, "unknown_top_level_field", "Unknown top-level attestation fields are forbidden.")
}

release_ok := normalize_text(dict_get_or(release, "repository", "")) == "kujolang/rag" && normalize_text(dict_get_or(release, "commit", "")) != "" && normalize_text(dict_get_or(release, "kujo_version", "")) != ""
if require_approved && release_ok == false {
	blockers = add_blocker(blockers, "release_identity_incomplete", "Repository commit and Kujo runtime version must identify the deployed release.")
}

algorithm_allowlist := dict_get_or(proxy, "jwt_algorithm_allowlist", [])
proxy_controls_ok := normalize_text(dict_get_or(proxy, "provider", "")) != "" && normalize_text(dict_get_or(proxy, "public_hostname", "")) != "" && bool_or(dict_get_or(proxy, "origin_private", false), false) && bool_or(dict_get_or(proxy, "jwt_signature_verified", false), false) && type(algorithm_allowlist) == "array" && len(algorithm_allowlist) > 0 && normalize_text(dict_get_or(proxy, "jwt_issuer", "")) != "" && normalize_text(dict_get_or(proxy, "jwt_audience", "")) != "" && bool_or(dict_get_or(proxy, "jwt_expiry_enforced", false), false) && bool_or(dict_get_or(proxy, "jwks_fail_closed", false), false) && bool_or(dict_get_or(proxy, "untrusted_identity_headers_stripped", false), false) && bool_or(dict_get_or(proxy, "verified_claim_headers_rebuilt", false), false) && bool_or(dict_get_or(proxy, "proxy_secret_from_secret_manager", false), false) && bool_or(dict_get_or(proxy, "direct_origin_blocked", false), false) && bool_or(dict_get_or(proxy, "backend_peer_allowlist_verified", false), false) && bool_or(dict_get_or(proxy, "rbac_mapping_verified", false), false)
if require_approved && proxy_controls_ok == false {
	blockers = add_blocker(blockers, "proxy_controls_incomplete", "Proxy JWT validation, header integrity, origin isolation, peer allowlisting, and RBAC mapping must all be verified.")
}

audit_controls_ok := normalize_text(dict_get_or(audit_sink, "provider", "")) != "" && normalize_text(dict_get_or(audit_sink, "destination", "")) != "" && bool_or(dict_get_or(audit_sink, "separate_security_boundary", false), false) && bool_or(dict_get_or(audit_sink, "append_only_writer_credentials", false), false) && bool_or(dict_get_or(audit_sink, "delete_admin_separated", false), false) && bool_or(dict_get_or(audit_sink, "immutable_retention_enabled", false), false) && num_or(dict_get_or(audit_sink, "retention_days", 0), 0) > 0 && bool_or(dict_get_or(audit_sink, "encryption_at_rest", false), false) && bool_or(dict_get_or(audit_sink, "export_health_monitored", false), false) && bool_or(dict_get_or(audit_sink, "readback_verified", false), false)
if require_approved && audit_controls_ok == false {
	blockers = add_blocker(blockers, "audit_sink_controls_incomplete", "The audit sink must be independently protected, immutable, monitored, encrypted, and read-back verified.")
}

proxy_evidence := evidence_review(dict_get_or(proxy, "evidence", []), evidence_root)
audit_evidence := evidence_review(dict_get_or(audit_sink, "evidence", []), evidence_root)
if require_approved && dict_get_or(proxy_evidence, "ok", false) == false {
	for blocker in dict_get_or(proxy_evidence, "blockers", []) { blockers = push(blockers, blocker) }
}
if require_approved && dict_get_or(audit_evidence, "ok", false) == false {
	for blocker in dict_get_or(audit_evidence, "blockers", []) { blockers = push(blockers, blocker) }
}

approval_ok := normalize_text(dict_get_or(approvals, "status", "")) == "approved" && normalize_text(dict_get_or(approvals, "security_reviewer", "")) != "" && normalize_text(dict_get_or(approvals, "operations_reviewer", "")) != "" && num_or(dict_get_or(approvals, "approved_at_unix_ms", 0), 0) > 0
if require_approved && approval_ok == false {
	blockers = add_blocker(blockers, "approval_incomplete", "Named Security and Operations reviewers must approve the production attestation.")
}
if require_approved && environment_id == "" {
	blockers = add_blocker(blockers, "environment_id_required", "A non-secret production environment identifier is required.")
}

ok := len(blockers) == 0 && secret_material_detected == false && unknown_top_level_detected == false
secret_material_absent := secret_material_detected == false
schema_fields_known := unknown_top_level_detected == false
result := {
	"ok": ok,
	"generated_at_unix_ms": current_timestamp(),
	"attestation_path": attestation_path,
	"evidence_root": evidence_root,
	"require_approved": require_approved,
	"secret_material_detected": secret_material_detected,
	"gates": {"schema_fields_known": schema_fields_known, "secret_material_absent": secret_material_absent, "release_identity": release_ok, "proxy_controls": proxy_controls_ok, "proxy_evidence": dict_get_or(proxy_evidence, "ok", false), "audit_sink_controls": audit_controls_ok, "audit_sink_evidence": dict_get_or(audit_evidence, "ok", false), "approval": approval_ok},
	"proxy_evidence": dict_get_or(proxy_evidence, "items", []),
	"audit_sink_evidence": dict_get_or(audit_evidence, "items", []),
	"blockers": blockers
}
write_json_file(output_path, result)
print(to_json(result))
if ok == false { exit(1) }
