from src.common import dict_get_or

func print_json(payload) {
	print(to_json(payload))
}

func exit_json(payload) {
	print_json(payload)
	exit(1)
}

func read_result_error_payload(result) {
	return {
		"ok": false,
		"error": dict_get_or(result, "error", "read_error"),
		"message": dict_get_or(result, "message", "Unable to read JSON file")
	}
}

func read_json_file(path) {
	if file_exists(path) == false {
		return {
			"ok": false,
			"error": "missing_file",
			"message": "File not found: " + path,
			"data": {}
		}
	}
	raw := read_file(path)
	err := null
	parsed := {}
	try {
		parsed := parse_json(raw)
	} except e {
		err := e
	}
	if type(err) != "null" {
		return {
			"ok": false,
			"error": "invalid_json",
			"message": to_string(err),
			"data": {}
		}
	}
	return {
		"ok": true,
		"data": parsed
	}
}

func evaluate_threshold(metric_name, value, alert_threshold, page_threshold, runbook, higher_is_bad) {
	state := "ok"
	if higher_is_bad {
		if value >= page_threshold {
			state = "page"
		} else if value >= alert_threshold {
			state = "alert"
		}
	} else {
		if value <= page_threshold {
			state = "page"
		} else if value <= alert_threshold {
			state = "alert"
		}
	}
	return {
		"metric": metric_name,
		"value": value,
		"state": state,
		"runbook": runbook
	}
}

func evaluate_metric(metrics, slos, metric_name, slo_name, alert_key, page_key, default_value, default_alert, default_page, higher_is_bad) {
	slo := dict_get_or(slos, slo_name, {})
	return evaluate_threshold(
		metric_name,
		dict_get_or(metrics, metric_name, default_value),
		dict_get_or(slo, alert_key, default_alert),
		dict_get_or(slo, page_key, default_page),
		dict_get_or(slo, "runbook", ""),
		higher_is_bad
	)
}

func main() {
	slo_path := env_or("SLO_PATH", "config/slo_targets.json")
	metrics_path := env_or("SLO_METRICS_PATH", "results/slo_metrics_snapshot.json")

	slo_res := read_json_file(slo_path)
	if slo_res["ok"] == false {
		exit_json(read_result_error_payload(slo_res))
	}
	slos := slo_res["data"]

	metrics_res := read_json_file(metrics_path)
	if metrics_res["ok"] == false {
		exit_json(read_result_error_payload(metrics_res))
	}
	metrics := metrics_res["data"]

	alerts := []
	alerts = push(alerts, evaluate_metric(
		metrics,
		slos,
		"availability",
		"availability",
		"alert_threshold",
		"page_threshold",
		1.0,
		0.992,
		0.99,
		false
	))
	alerts = push(alerts, evaluate_metric(
		metrics,
		slos,
		"query_latency_p95_ms",
		"query_latency_p95_ms",
		"alert_threshold",
		"page_threshold",
		0,
		1400,
		1700,
		true
	))
	alerts = push(alerts, evaluate_metric(
		metrics,
		slos,
		"answer_correctness",
		"answer_correctness",
		"alert_threshold",
		"page_threshold",
		1.0,
		0.87,
		0.84,
		false
	))
	alerts = push(alerts, evaluate_metric(
		metrics,
		slos,
		"error_budget_burn",
		"error_budget",
		"burn_alert_threshold",
		"burn_page_threshold",
		0.0,
		0.5,
		0.75,
		true
	))

	has_page := false
	has_alert := false
	for alert in alerts {
		state := dict_get_or(alert, "state", "ok")
		if state == "page" {
			has_page = true
		}
		if state == "alert" {
			has_alert = true
		}
	}

	overall := "ok"
	if has_page {
		overall = "page"
	} else if has_alert {
		overall = "alert"
	}

	print_json({
		"ok": true,
		"overall": overall,
		"alerts": alerts
	})
}

main()
