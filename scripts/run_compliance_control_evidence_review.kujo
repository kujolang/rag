from src.common import dict_get_or, read_json_file_or, write_json_file, num_or, str_or

func ensure_dir(path_value) {
	if path_value == "" || path_value == "." {
		return true
	}
	if path_exists(path_value) {
		return true
	}
	parent := dirname(path_value)
	if parent != "" && parent != "." && parent != path_value {
		_ = ensure_dir(parent)
	}
	create_dir(path_value)
	return true
}

func ensure_parent_dir(path_value) {
	dir := dirname(path_value)
	if dir == "" || dir == "." {
		return true
	}
	return ensure_dir(dir)
}

func normalize_text_array(raw_items) {
	items := []
	if type(raw_items) != "array" {
		return items
	}
	text_index := 0
	while text_index < len(raw_items) {
		value := trim(str_or(raw_items[text_index], ""))
		if value != "" {
			items = push(items, value)
		}
		text_index = text_index + 1
	}
	return items
}

func normalize_control(raw_control) {
	control := {
		"id": trim(str_or(dict_get_or(raw_control, "id", ""), "")),
		"title": trim(str_or(dict_get_or(raw_control, "title", ""), "")),
		"framework_refs": normalize_text_array(dict_get_or(raw_control, "framework_refs", [])),
		"owner": trim(str_or(dict_get_or(raw_control, "owner", ""), "")),
		"status": to_lower(trim(str_or(dict_get_or(raw_control, "status", "gap"), "gap"))),
		"description": trim(str_or(dict_get_or(raw_control, "description", ""), "")),
		"code": normalize_text_array(dict_get_or(raw_control, "code", [])),
		"config": normalize_text_array(dict_get_or(raw_control, "config", [])),
		"process": normalize_text_array(dict_get_or(raw_control, "process", [])),
		"evidence": normalize_text_array(dict_get_or(raw_control, "evidence", [])),
		"gap_summary": trim(str_or(dict_get_or(raw_control, "gap_summary", ""), "")),
		"gap_owner": trim(str_or(dict_get_or(raw_control, "gap_owner", ""), "")),
		"target_date": trim(str_or(dict_get_or(raw_control, "target_date", ""), ""))
	}
	return control
}

func control_all_paths(control) {
	paths := []
	code_paths := dict_get_or(control, "code", [])
	config_paths := dict_get_or(control, "config", [])
	process_paths := dict_get_or(control, "process", [])
	evidence_paths := dict_get_or(control, "evidence", [])

	path_index := 0
	while path_index < len(code_paths) {
		paths = push(paths, code_paths[path_index])
		path_index = path_index + 1
	}
	path_index = 0
	while path_index < len(config_paths) {
		paths = push(paths, config_paths[path_index])
		path_index = path_index + 1
	}
	path_index = 0
	while path_index < len(process_paths) {
		paths = push(paths, process_paths[path_index])
		path_index = path_index + 1
	}
	path_index = 0
	while path_index < len(evidence_paths) {
		paths = push(paths, evidence_paths[path_index])
		path_index = path_index + 1
	}

	return paths
}

func control_links_exist(control) {
	paths := control_all_paths(control)
	if len(paths) == 0 {
		return {
			"ok": false,
			"missing": []
		}
	}

	missing := []
	missing_index := 0
	while missing_index < len(paths) {
		path_value := trim(str_or(paths[missing_index], ""))
		if path_value != "" {
			if path_exists(path_value) == false {
				missing = push(missing, path_value)
			}
		}
		missing_index = missing_index + 1
	}

	return {
		"ok": len(missing) == 0,
		"missing": missing
	}
}

func is_unresolved_status(status) {
	return status == "partial" || status == "gap"
}

matrix_path := env_or("KUJO_RAG_COMPLIANCE_MATRIX_PATH", "./config/compliance_control_matrix.json")
output_path := env_or("KUJO_RAG_COMPLIANCE_REVIEW_OUTPUT_PATH", "./results/compliance/compliance_evidence_review.json")
workflow_doc_path := "./docs/compliance-evidence-review-workflow.md"
workflow_ci_path := "./.github/workflows/compliance-evidence-review.yml"

_ = ensure_parent_dir(output_path)

raw_matrix := read_json_file_or(matrix_path, {})
matrix_available := type(raw_matrix) == "dict" && len(keys(raw_matrix)) > 0

version := trim(str_or(dict_get_or(raw_matrix, "version", ""), ""))
last_reviewed_at_unix_ms := num_or(dict_get_or(raw_matrix, "last_reviewed_at_unix_ms", 0), 0)
review_cadence_days := num_or(dict_get_or(raw_matrix, "review_cadence_days", 30), 30)
if review_cadence_days < 1 {
	review_cadence_days = 1
}

raw_controls := dict_get_or(raw_matrix, "controls", [])
controls := []
if type(raw_controls) == "array" {
	raw_control_index := 0
	while raw_control_index < len(raw_controls) {
		control := normalize_control(raw_controls[raw_control_index])
		if dict_get_or(control, "id", "") != "" {
			controls = push(controls, control)
		}
		raw_control_index = raw_control_index + 1
	}
}

status_counts := {
	"covered": 0,
	"partial": 0,
	"gap": 0,
	"unknown": 0
}
control_checks := []
unresolved_gaps := []
owners_complete := true
links_resolve := true
unresolved_gaps_owned := true
controls_valid := true

control_index := 0
while control_index < len(controls) {
	control := controls[control_index]
	status := to_lower(trim(str_or(dict_get_or(control, "status", ""), "")))
	status_valid := status == "covered" || status == "partial" || status == "gap"
	if status_valid {
		status_counts[status] := dict_get_or(status_counts, status, 0) + 1
	} else {
		status_counts["unknown"] := dict_get_or(status_counts, "unknown", 0) + 1
	}

	has_owner := trim(str_or(dict_get_or(control, "owner", ""), "")) != ""
	has_mapping := len(control_all_paths(control)) > 0
	links := control_links_exist(control)
	link_ok := dict_get_or(links, "ok", false)
	missing_links := dict_get_or(links, "missing", [])

	if has_owner == false {
		owners_complete = false
	}
	if link_ok == false {
		links_resolve = false
	}

	gap_summary := trim(str_or(dict_get_or(control, "gap_summary", ""), ""))
	gap_owner := trim(str_or(dict_get_or(control, "gap_owner", ""), ""))
	target_date := trim(str_or(dict_get_or(control, "target_date", ""), ""))
	gap_fields_ok := true
	if is_unresolved_status(status) {
		gap_fields_ok = gap_summary != "" && gap_owner != "" && target_date != ""
		if gap_fields_ok == false {
			unresolved_gaps_owned = false
		}
		unresolved_gaps = push(unresolved_gaps, {
			"id": dict_get_or(control, "id", ""),
			"title": dict_get_or(control, "title", ""),
			"status": status,
			"gap_summary": gap_summary,
			"gap_owner": gap_owner,
			"target_date": target_date,
			"missing_links": missing_links
		})
	}

	control_ok := status_valid && has_owner && has_mapping && link_ok && gap_fields_ok
	if control_ok == false {
		controls_valid = false
	}

	control_checks = push(control_checks, {
		"id": dict_get_or(control, "id", ""),
		"status": status,
		"status_valid": status_valid,
		"has_owner": has_owner,
		"has_mapping": has_mapping,
		"links_resolve": link_ok,
		"gap_fields_ok": gap_fields_ok,
		"missing_links": missing_links,
		"ok": control_ok
	})

	control_index = control_index + 1
}

control_count := len(controls)
control_count_gate := control_count > 0
version_defined := version != ""
periodic_workflow_defined := review_cadence_days > 0 && path_exists(workflow_doc_path) && path_exists(workflow_ci_path)

review_due := false
if last_reviewed_at_unix_ms > 0 {
	review_due_at := last_reviewed_at_unix_ms + (review_cadence_days * 86400000)
	review_due = current_timestamp() >= review_due_at
}

gates := {
	"matrix_available": matrix_available,
	"version_defined": version_defined,
	"control_count": control_count_gate,
	"owners_complete": owners_complete,
	"links_resolve": links_resolve,
	"controls_valid": controls_valid,
	"periodic_workflow_defined": periodic_workflow_defined,
	"unresolved_gaps_owned": unresolved_gaps_owned
}

ok := true
gate_names := [
	"matrix_available",
	"version_defined",
	"control_count",
	"owners_complete",
	"links_resolve",
	"controls_valid",
	"periodic_workflow_defined",
	"unresolved_gaps_owned"
]
gate_index := 0
while gate_index < len(gate_names) {
	gate_name := gate_names[gate_index]
	if dict_get_or(gates, gate_name, false) == false {
		ok = false
	}
	gate_index = gate_index + 1
}

result := {
	"ok": ok,
	"generated_at_unix_ms": current_timestamp(),
	"matrix_path": matrix_path,
	"output_path": output_path,
	"version": version,
	"last_reviewed_at_unix_ms": last_reviewed_at_unix_ms,
	"review_cadence_days": review_cadence_days,
	"review_due": review_due,
	"control_count": control_count,
	"status_counts": status_counts,
	"unresolved_gap_count": len(unresolved_gaps),
	"unresolved_gaps": unresolved_gaps,
	"control_checks": control_checks,
	"gates": gates
}

write_json_file(output_path, result)
print(to_json(result))

if ok == false {
	exit(1)
}
