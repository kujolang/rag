from src.release_eval import run_release_evaluation
from src.common import dict_get_or, read_json_file_or, write_json_file, num_or, str_or

func ensure_dir(path_value) {
	if path_value == "" || path_value == "." {
		return true
	}
	if path_exists(path_value) {
		return true
	}
	parent := dirname(path_value)
	if parent != "" && parent != "." && parent != path_value {
		_ = ensure_dir(parent)
	}
	create_dir(path_value)
	return true
}

func ensure_parent_dir(path_value) {
	dir := dirname(path_value)
	if dir == "" || dir == "." {
		return true
	}
	return ensure_dir(dir)
}

func normalize_release_thresholds(raw_thresholds) {
	thresholds := {
		"min_quality_pass_rate": 0.875,
		"max_error_rate": 0.0,
		"max_avg_latency_ms": 10000,
		"max_p95_latency_ms": 20000,
		"min_average_confidence": 0.25,
		"min_average_grounding": 0.5,
		"min_case_count": 8
	}
	if type(raw_thresholds) != "dict" {
		return thresholds
	}

	thresholds["min_quality_pass_rate"] = num_or(dict_get_or(raw_thresholds, "min_quality_pass_rate", thresholds["min_quality_pass_rate"]), thresholds["min_quality_pass_rate"])
	thresholds["max_error_rate"] = num_or(dict_get_or(raw_thresholds, "max_error_rate", thresholds["max_error_rate"]), thresholds["max_error_rate"])
	thresholds["max_avg_latency_ms"] = num_or(dict_get_or(raw_thresholds, "max_avg_latency_ms", thresholds["max_avg_latency_ms"]), thresholds["max_avg_latency_ms"])
	thresholds["max_p95_latency_ms"] = num_or(dict_get_or(raw_thresholds, "max_p95_latency_ms", thresholds["max_p95_latency_ms"]), thresholds["max_p95_latency_ms"])
	thresholds["min_average_confidence"] = num_or(dict_get_or(raw_thresholds, "min_average_confidence", thresholds["min_average_confidence"]), thresholds["min_average_confidence"])
	thresholds["min_average_grounding"] = num_or(dict_get_or(raw_thresholds, "min_average_grounding", thresholds["min_average_grounding"]), thresholds["min_average_grounding"])
	thresholds["min_case_count"] = num_or(dict_get_or(raw_thresholds, "min_case_count", thresholds["min_case_count"]), thresholds["min_case_count"])

	if thresholds["min_case_count"] < 1 {
		thresholds["min_case_count"] = 1
	}

	return thresholds
}

func normalize_language_thresholds(raw_thresholds) {
	thresholds := {
		"min_language_count": 2,
		"required_languages": [],
		"min_language_quality_pass_rate": 0.75,
		"min_non_english_quality_pass_rate": 0.75,
		"min_non_english_case_count": 1
	}
	if type(raw_thresholds) != "dict" {
		return thresholds
	}

	thresholds["min_language_count"] = num_or(dict_get_or(raw_thresholds, "min_language_count", thresholds["min_language_count"]), thresholds["min_language_count"])
	thresholds["min_language_quality_pass_rate"] = num_or(dict_get_or(raw_thresholds, "min_language_quality_pass_rate", thresholds["min_language_quality_pass_rate"]), thresholds["min_language_quality_pass_rate"])
	thresholds["min_non_english_quality_pass_rate"] = num_or(dict_get_or(raw_thresholds, "min_non_english_quality_pass_rate", thresholds["min_non_english_quality_pass_rate"]), thresholds["min_non_english_quality_pass_rate"])
	thresholds["min_non_english_case_count"] = num_or(dict_get_or(raw_thresholds, "min_non_english_case_count", thresholds["min_non_english_case_count"]), thresholds["min_non_english_case_count"])

	if thresholds["min_language_count"] < 1 {
		thresholds["min_language_count"] = 1
	}
	if thresholds["min_non_english_case_count"] < 0 {
		thresholds["min_non_english_case_count"] = 0
	}

	raw_required := dict_get_or(raw_thresholds, "required_languages", [])
	required := []
	if type(raw_required) == "array" {
		i := 0
		while i < len(raw_required) {
			entry := to_lower(trim(str_or(raw_required[i], "")))
			if entry != "" {
				required = push(required, entry)
			}
			i = i + 1
		}
	}
	thresholds["required_languages"] = required
	return thresholds
}

func language_summary_lookup(raw_summary) {
	lookup := {}
	if type(raw_summary) != "array" {
		return lookup
	}
	i := 0
	while i < len(raw_summary) {
		item := raw_summary[i]
		if type(item) == "dict" {
			language := to_lower(trim(str_or(dict_get_or(item, "language", ""), "")))
			if language != "" {
				lookup[language] = item
			}
		}
		i = i + 1
	}
	return lookup
}

func non_english_quality_summary(language_lookup) {
	non_english_cases := 0
	non_english_passed := 0
	for language in keys(language_lookup) {
		if language != "english" {
			bucket := dict_get_or(language_lookup, language, {})
			non_english_cases = non_english_cases + num_or(dict_get_or(bucket, "total_cases", 0), 0)
			non_english_passed = non_english_passed + num_or(dict_get_or(bucket, "passed_cases", 0), 0)
		}
	}
	quality := 0.0
	if non_english_cases > 0 {
		quality = to_float(non_english_passed) / to_float(non_english_cases)
	}
	return {
		"cases": non_english_cases,
		"passed_cases": non_english_passed,
		"quality_pass_rate": quality
	}
}

output_path := env_or("KUJO_RAG_MULTILINGUAL_EVAL_OUTPUT_PATH", "./results/multilingual_release_eval_report.json")
thresholds_path := env_or("KUJO_RAG_MULTILINGUAL_EVAL_THRESHOLDS_PATH", "./config/multilingual_release_eval_thresholds.json")

_ = ensure_parent_dir(output_path)

thresholds_payload := read_json_file_or(thresholds_path, {})
release_thresholds := normalize_release_thresholds(dict_get_or(thresholds_payload, "release_eval_thresholds", thresholds_payload))
language_thresholds := normalize_language_thresholds(dict_get_or(thresholds_payload, "language_thresholds", {}))

release_thresholds_path := "/tmp/kujo_rag_multilingual_release_thresholds_" + to_string(current_timestamp()) + ".json"
write_json_file(release_thresholds_path, release_thresholds)

eval_cfg := {
	"golden_queries_path": env_or("KUJO_RAG_MULTILINGUAL_EVAL_GOLDEN_PATH", "./config/multilingual_release_eval_golden_queries.json"),
	"thresholds_path": release_thresholds_path,
	"corpus_path": env_or("KUJO_RAG_MULTILINGUAL_EVAL_CORPUS_PATH", "./examples/multilingual_release_eval_corpus"),
	"index_path": env_or("KUJO_RAG_MULTILINGUAL_EVAL_INDEX_PATH", "./results/multilingual_release_eval_index.json"),
	"embedding_provider": env_or("KUJO_RAG_MULTILINGUAL_EVAL_EMBEDDING_PROVIDER", env_or("KUJO_RAG_RELEASE_EVAL_EMBEDDING_PROVIDER", "hash")),
	"recursive": true
}

release_eval_result := run_release_evaluation(eval_cfg)
metrics := dict_get_or(release_eval_result, "metrics", {})
language_summary := dict_get_or(metrics, "language_summary", [])
language_lookup := language_summary_lookup(language_summary)
required_languages := dict_get_or(language_thresholds, "required_languages", [])

language_checks := []
required_languages_ok := true
required_language_quality_ok := true

i := 0
while i < len(required_languages) {
	language := str_or(required_languages[i], "")
	present := has_key(language_lookup, language) == 1
	quality_ok := false
	quality_value := 0.0
	if present {
		bucket := dict_get_or(language_lookup, language, {})
		quality_value = num_or(dict_get_or(bucket, "quality_pass_rate", 0.0), 0.0)
		quality_ok = quality_value >= num_or(dict_get_or(language_thresholds, "min_language_quality_pass_rate", 0.75), 0.75)
	}
	if present == false {
		required_languages_ok = false
	}
	if quality_ok == false {
		required_language_quality_ok = false
	}
	language_checks = push(language_checks, {
		"language": language,
		"present": present,
		"quality_pass_rate": quality_value,
		"quality_ok": quality_ok
	})
	i = i + 1
}

non_english := non_english_quality_summary(language_lookup)
non_english_case_count := num_or(dict_get_or(non_english, "cases", 0), 0)
non_english_quality := num_or(dict_get_or(non_english, "quality_pass_rate", 0.0), 0.0)

gates := {
	"release_eval_ok": dict_get_or(release_eval_result, "ok", false) == true,
	"minimum_language_count": len(language_summary) >= num_or(dict_get_or(language_thresholds, "min_language_count", 2), 2),
	"required_languages": required_languages_ok,
	"required_language_quality": required_language_quality_ok,
	"minimum_non_english_case_count": non_english_case_count >= num_or(dict_get_or(language_thresholds, "min_non_english_case_count", 1), 1),
	"non_english_quality_pass_rate": non_english_quality >= num_or(dict_get_or(language_thresholds, "min_non_english_quality_pass_rate", 0.75), 0.75)
}

ok := true
for key in keys(gates) {
	if dict_get_or(gates, key, false) == false {
		ok = false
	}
}

result := {
	"ok": ok,
	"generated_at_unix_ms": current_timestamp(),
	"output_path": output_path,
	"thresholds_path": thresholds_path,
	"release_eval_thresholds": release_thresholds,
	"language_thresholds": language_thresholds,
	"release_eval": release_eval_result,
	"language_summary": language_summary,
	"language_checks": language_checks,
	"non_english_summary": non_english,
	"gates": gates
}

write_json_file(output_path, result)
print(to_json(result))

if file_exists(release_thresholds_path) {
	delete_file(release_thresholds_path)
}

if ok == false {
	exit(1)
}
