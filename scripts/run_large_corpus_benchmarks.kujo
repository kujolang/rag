from src.common import dict_get_or, read_json_file_or, write_json_file, num_or, str_or
from src.config import load_config, ensure_runtime_dirs
from src.rag_engine import build_rag_index, load_or_initialize_index, query_rag

func ensure_dir(path_value) {
	if path_value == "" || path_value == "." {
		return true
	}
	if path_exists(path_value) == false {
		create_dir(path_value)
	}
	return true
}

func ensure_parent_dir(path_value) {
	dir := dirname(path_value)
	if dir == "" || dir == "." {
		return true
	}
	if starts_with(dir, "./results/") {
		_ = ensure_dir("./results")
		_ = ensure_dir("./results/" + split(dir, "/")[2])
	}
	return ensure_dir(dir)
}

func sanitize_name(raw_value, fallback_value) {
	value := trim(to_lower(to_string(raw_value)))
	if value == "" {
		value = fallback_value
	}
	value = regex_replace(value, "[^a-z0-9_-]", "_")
	if value == "" {
		return fallback_value
	}
	return value
}

func normalize_profiles(raw_profiles) {
	profiles := []
	if type(raw_profiles) != "array" {
		return profiles
	}

	i := 0
	while i < len(raw_profiles) {
		item := raw_profiles[i]
		if type(item) == "dict" {
			name := sanitize_name(dict_get_or(item, "name", "profile_" + to_string(i + 1)), "profile_" + to_string(i + 1))
			copies := num_or(dict_get_or(item, "copies_per_source", 1), 1)
			if copies < 1 {
				copies = 1
			}
			query_iterations := num_or(dict_get_or(item, "query_iterations", 1), 1)
			if query_iterations < 1 {
				query_iterations = 1
			}

			profiles = push(profiles, {
				"name": name,
				"copies_per_source": copies,
				"query_iterations": query_iterations
			})
		}
		i = i + 1
	}

	return profiles
}

func normalize_queries(raw_queries) {
	queries := []
	if type(raw_queries) != "array" {
		return queries
	}
	i := 0
	while i < len(raw_queries) {
		candidate := trim(str_or(raw_queries[i], ""))
		if candidate != "" {
			queries = push(queries, candidate)
		}
		i = i + 1
	}
	return queries
}

func discover_files_recursive(root_path) {
	files := []
	if path_exists(root_path) == false {
		return files
	}

	stack := [root_path]
	while len(stack) > 0 {
		current := stack[len(stack) - 1]
		stack = slice(stack, 0, len(stack) - 1)

		if path_is_file(current) {
			files = push(files, current)
			continue
		}

		if path_is_dir(current) {
			entries := []
			err := null
			try {
				entries := list_dir(current)
			} except e {
				err = e
			}
			if type(err) == "null" {
				i := 0
				while i < len(entries) {
					stack = push(stack, path_join(current, entries[i]))
					i = i + 1
				}
			}
		}
	}

	return files
}

func file_basename(path_value) {
	parts := split(path_value, "/")
	if len(parts) == 0 {
		return path_value
	}
	return to_string(parts[len(parts) - 1])
}

func sort_numbers(values) {
	sorted := []
	i := 0
	while i < len(values) {
		value := num_or(values[i], 0)
		inserted := false
		next_sorted := []
		j := 0
		while j < len(sorted) {
			existing := num_or(sorted[j], 0)
			if inserted == false && value < existing {
				next_sorted = push(next_sorted, value)
				inserted = true
			}
			next_sorted = push(next_sorted, existing)
			j = j + 1
		}
		if inserted == false {
			next_sorted = push(next_sorted, value)
		}
		sorted = next_sorted
		i = i + 1
	}
	return sorted
}

func average(values) {
	if len(values) == 0 {
		return 0.0
	}
	sum := 0.0
	i := 0
	while i < len(values) {
		sum = sum + num_or(values[i], 0.0)
		i = i + 1
	}
	return sum / to_float(len(values))
}

func percentile_95(values) {
	if len(values) == 0 {
		return 0.0
	}
	sorted := sort_numbers(values)
	n := len(sorted)
	i := 0
	while i < n {
		if (i + 1) * 100 >= n * 95 {
			return num_or(sorted[i], 0.0)
		}
		i = i + 1
	}
	return num_or(sorted[n - 1], 0.0)
}

func materialize_dataset(profile_name, source_files, copies_per_source, dataset_dir) {
	total_docs := 0
	source_index := 0
	while source_index < len(source_files) {
		source_path := source_files[source_index]
		base_name := file_basename(source_path)
		content := read_file(source_path)
		copy_index := 0
		while copy_index < copies_per_source {
			out_name := profile_name + "__s" + to_string(source_index) + "__c" + to_string(copy_index) + "__" + base_name
			out_path := path_join(dataset_dir, out_name)
			if file_exists(out_path) {
				delete_file(out_path)
			}
			write_file(out_path, content)
			total_docs = total_docs + 1
			copy_index = copy_index + 1
		}
		source_index = source_index + 1
	}
	return total_docs
}

func resolve_budget(dataset_budgets, profile_name) {
	item := dict_get_or(dataset_budgets, profile_name, {})
	if type(item) != "dict" {
		item = {}
	}
	return {
		"min_ingest_docs_per_sec": num_or(dict_get_or(item, "min_ingest_docs_per_sec", 0.0), 0.0),
		"max_avg_query_latency_ms": num_or(dict_get_or(item, "max_avg_query_latency_ms", 999999.0), 999999.0),
		"max_p95_query_latency_ms": num_or(dict_get_or(item, "max_p95_query_latency_ms", 999999.0), 999999.0)
	}
}

func benchmark_profile(profile, source_files, queries, dataset_budgets, dataset_root, index_root, run_id) {
	profile_name := dict_get_or(profile, "name", "profile")
	copies_per_source := num_or(dict_get_or(profile, "copies_per_source", 1), 1)
	if copies_per_source < 1 {
		copies_per_source = 1
	}
	query_iterations := num_or(dict_get_or(profile, "query_iterations", 1), 1)
	if query_iterations < 1 {
		query_iterations = 1
	}

	dataset_dir := path_join(dataset_root, profile_name + "_" + run_id)
	_ = ensure_dir(dataset_dir)
	materialized_docs := materialize_dataset(profile_name, source_files, copies_per_source, dataset_dir)

	cfg := load_config({})
	index_path := path_join(index_root, "benchmark_index_" + profile_name + "_" + run_id + ".json")
	cfg["index_path"] := index_path
	_ = ensure_runtime_dirs(cfg)
	if file_exists(index_path) {
		delete_file(index_path)
	}

	ingest_started := current_timestamp()
	ingest_result := {}
	ingest_error := ""
	try {
		ingest_result := build_rag_index(dataset_dir, cfg, true)
	} except e {
		ingest_error = to_string(e)
	}
	ingest_elapsed_ms := current_timestamp() - ingest_started
	if ingest_elapsed_ms < 0 {
		ingest_elapsed_ms = 0
	}

	ingest_stats := dict_get_or(dict_get_or(ingest_result, "ingest", {}), "stats", {})
	docs_loaded := num_or(dict_get_or(ingest_stats, "docs_loaded", 0), 0)
	if docs_loaded <= 0 {
		docs_loaded = materialized_docs
	}
	ingest_docs_per_sec := 0.0
	if ingest_elapsed_ms > 0 {
		ingest_docs_per_sec = (to_float(docs_loaded) * 1000.0) / to_float(ingest_elapsed_ms)
	}

	latencies := []
	query_runs := 0
	query_errors := 0
	if ingest_error == "" {
		index := load_or_initialize_index(cfg)
		q_i := 0
		while q_i < len(queries) {
			query_text := queries[q_i]
			i := 0
			while i < query_iterations {
				query_started := current_timestamp()
				query_error := ""
				query_result := {}
				try {
					query_result := query_rag(index, query_text, cfg, null, null)
				} except e {
					query_error = to_string(e)
				}
				query_elapsed_ms := current_timestamp() - query_started
				if query_elapsed_ms < 0 {
					query_elapsed_ms = 0
				}
				latencies = push(latencies, query_elapsed_ms)
				query_runs = query_runs + 1
				if query_error != "" {
					query_errors = query_errors + 1
				} else {
					citations := dict_get_or(query_result, "citations", [])
					if type(citations) != "array" {
						query_errors = query_errors + 1
					}
				}
				i = i + 1
			}
			q_i = q_i + 1
		}
	}

	query_avg_ms := average(latencies)
	query_p95_ms := percentile_95(latencies)
	budget := resolve_budget(dataset_budgets, profile_name)
	gate_ingest := ingest_docs_per_sec >= dict_get_or(budget, "min_ingest_docs_per_sec", 0.0)
	gate_avg_latency := query_avg_ms <= dict_get_or(budget, "max_avg_query_latency_ms", 999999.0)
	gate_p95_latency := query_p95_ms <= dict_get_or(budget, "max_p95_query_latency_ms", 999999.0)
	gate_query_errors := query_errors == 0 && query_runs > 0

	profile_ok := ingest_error == "" && gate_ingest && gate_avg_latency && gate_p95_latency && gate_query_errors

	return {
		"name": profile_name,
		"ok": profile_ok,
		"dataset": {
			"dataset_dir": dataset_dir,
			"materialized_docs": materialized_docs,
			"source_files": len(source_files),
			"copies_per_source": copies_per_source
		},
		"ingest": {
			"elapsed_ms": ingest_elapsed_ms,
			"docs_loaded": docs_loaded,
			"docs_per_sec": ingest_docs_per_sec,
			"error": ingest_error
		},
		"query": {
			"query_count": len(queries),
			"iterations_per_query": query_iterations,
			"runs": query_runs,
			"errors": query_errors,
			"avg_latency_ms": query_avg_ms,
			"p95_latency_ms": query_p95_ms
		},
		"budgets": budget,
		"gates": {
			"ingest_throughput": gate_ingest,
			"query_avg_latency": gate_avg_latency,
			"query_p95_latency": gate_p95_latency,
			"query_errors": gate_query_errors
		}
	}
}

func append_trend(trend_path, trend_limit, run_result) {
	trend_payload := read_json_file_or(trend_path, {
		"history": []
	})
	history := dict_get_or(trend_payload, "history", [])
	if type(history) != "array" {
		history = []
	}

	history = push(history, {
		"generated_at_unix_ms": dict_get_or(run_result, "generated_at_unix_ms", current_timestamp()),
		"ok": dict_get_or(run_result, "ok", false),
		"profile_count": len(dict_get_or(run_result, "profiles", [])),
		"profiles": dict_get_or(run_result, "profiles", [])
	})

	if len(history) > trend_limit {
		history = slice(history, len(history) - trend_limit, len(history))
	}

	write_json_file(trend_path, {
		"updated_at_unix_ms": current_timestamp(),
		"limit": trend_limit,
		"history": history
	})

	return len(history)
}

profiles_path := env_or("KUJO_RAG_BENCHMARK_PROFILES_PATH", "./config/large_corpus_benchmark_profiles.json")
budgets_path := env_or("KUJO_RAG_BENCHMARK_BUDGETS_PATH", "./config/large_corpus_benchmark_budgets.json")
output_path := env_or("KUJO_RAG_BENCHMARK_OUTPUT_PATH", "./results/large_corpus_benchmark_report.json")
trend_path := env_or("KUJO_RAG_BENCHMARK_TREND_PATH", "./results/large_corpus_benchmark_trend.json")
dataset_root := env_or("KUJO_RAG_BENCHMARK_DATASET_ROOT", "./results/benchmark_datasets")
index_root := env_or("KUJO_RAG_BENCHMARK_INDEX_ROOT", "./results/benchmark_indexes")

_ = ensure_dir("./results")
_ = ensure_dir(dataset_root)
_ = ensure_dir(index_root)
_ = ensure_parent_dir(output_path)
_ = ensure_parent_dir(trend_path)

profiles_cfg := read_json_file_or(profiles_path, {})
source_corpus_path := str_or(dict_get_or(profiles_cfg, "source_corpus_path", "./examples/kujo_docs"), "./examples/kujo_docs")
profiles := normalize_profiles(dict_get_or(profiles_cfg, "datasets", []))
queries := normalize_queries(dict_get_or(profiles_cfg, "queries", []))

if len(profiles) == 0 {
	profiles = [
		{"name": "small", "copies_per_source": 6, "query_iterations": 2},
		{"name": "medium", "copies_per_source": 20, "query_iterations": 2},
		{"name": "large", "copies_per_source": 60, "query_iterations": 3}
	]
}

if len(queries) == 0 {
	queries = [
		"How does Kujo handle module imports?",
		"What endpoints are in the sample API reference?",
		"What makes Kujo performant?",
		"What typing model does Kujo support?"
	]
}

budgets_cfg := read_json_file_or(budgets_path, {})
dataset_budgets := dict_get_or(budgets_cfg, "datasets", {})
if type(dataset_budgets) != "dict" {
	dataset_budgets = {}
}
trend_history_limit := num_or(dict_get_or(budgets_cfg, "trend_history_limit", 120), 120)
if trend_history_limit < 1 {
	trend_history_limit = 1
}

source_files := discover_files_recursive(source_corpus_path)
profile_results := []
overall_ok := true
error_message := ""

if len(source_files) == 0 {
	overall_ok = false
	error_message = "source corpus has no files: " + source_corpus_path
} else {
	run_id := to_string(current_timestamp())
	i := 0
	while i < len(profiles) {
		profile_result := benchmark_profile(profiles[i], source_files, queries, dataset_budgets, dataset_root, index_root, run_id)
		profile_results = push(profile_results, profile_result)
		if dict_get_or(profile_result, "ok", false) == false {
			overall_ok = false
		}
		i = i + 1
	}
}

result := {
	"ok": overall_ok,
	"generated_at_unix_ms": current_timestamp(),
	"profiles_path": profiles_path,
	"budgets_path": budgets_path,
	"source_corpus_path": source_corpus_path,
	"query_count": len(queries),
	"profile_count": len(profiles),
	"profiles": profile_results,
	"error": error_message
}

history_count := append_trend(trend_path, trend_history_limit, result)
result["trend_path"] = trend_path
result["trend_history_count"] = history_count

write_json_file(output_path, result)
print(to_json(result))

if overall_ok == false {
	exit(1)
}
