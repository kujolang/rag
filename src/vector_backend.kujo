from src.common import dict_get_or, bool_or, num_or, read_json_file_or, write_json_file
from src.vector_store import load_index_with_config, persist_index_with_config, save_index_with_config

func normalize_backend_name(cfg) {
	backend_name := to_lower(trim(to_string(dict_get_or(cfg, "vector_backend", "local_json"))))
	if backend_name == "" {
		return "local_json"
	}
	if backend_name != "local_json" && backend_name != "memory" && backend_name != "qdrant_http" {
		return "local_json"
	}
	return backend_name
}

func shell_quote(value) {
	if type(value) != "string" {
		return "''"
	}
	escaped := regex_replace(value, "'", "'\"'\"'")
	return "'" + escaped + "'"
}

func command_success(result) {
	if type(result) == "struct" {
		return result.success
	}
	if type(result) == "dict" {
		return dict_get_or(result, "success", false)
	}
	return false
}

func command_stderr(result) {
	if type(result) == "struct" {
		return to_string(result.stderr)
	}
	if type(result) == "dict" {
		return to_string(dict_get_or(result, "stderr", ""))
	}
	return ""
}

func command_stdout(result) {
	if type(result) == "struct" {
		return to_string(result.stdout)
	}
	if type(result) == "dict" {
		return to_string(dict_get_or(result, "stdout", ""))
	}
	return ""
}

func remove_file_if_exists(path_value) {
	if file_exists(path_value) {
		delete_file(path_value)
	}
}

func memory_store_key(cfg) {
	configured_key := dict_get_or(cfg, "vector_backend_memory_key", "")
	if type(configured_key) == "string" && trim(configured_key) != "" {
		return trim(configured_key)
	}
	namespace := dict_get_or(cfg, "namespace", "default")
	if type(namespace) == "string" && trim(namespace) != "" {
		return trim(namespace)
	}
	return "default"
}

func memory_backend_path(cfg) {
	key := memory_store_key(cfg)
	hash := substring(sha256(key), 0, 16)
	return "./results/vector_backend_memory__" + hash + ".json"
}

func local_json_load(cfg) {
	path := dict_get_or(cfg, "index_path", "./data/rag_index.json")
	return load_index_with_config(path, cfg)
}

func local_json_save(cfg, index) {
	path := dict_get_or(cfg, "index_path", "./data/rag_index.json")
	return save_index_with_config(path, index, cfg)
}

func qdrant_collection_name(cfg) {
	configured := to_lower(trim(to_string(dict_get_or(cfg, "vector_backend_qdrant_collection", ""))))
	if configured == "" {
		configured = to_lower(trim(to_string(dict_get_or(cfg, "namespace", "default"))))
	}
	if configured == "" {
		configured = "default"
	}
	invalid := regex_replace(configured, "[a-z0-9_-]", "")
	if invalid != "" {
		configured = "ns_" + substring(sha256(configured), 0, 10)
	}
	return configured
}

func qdrant_sync_enabled(cfg) {
	return bool_or(dict_get_or(cfg, "vector_backend_qdrant_sync_enabled", false), false)
}

func qdrant_fail_open(cfg) {
	return bool_or(dict_get_or(cfg, "vector_backend_qdrant_fail_open", true), true)
}

func qdrant_timeout_ms(cfg) {
	timeout_ms := num_or(dict_get_or(cfg, "vector_backend_qdrant_timeout_ms", 8000), 8000)
	if timeout_ms < 1000 {
		timeout_ms = 1000
	}
	if timeout_ms > 120000 {
		timeout_ms = 120000
	}
	return timeout_ms
}

func qdrant_base_url(cfg) {
	url := trim(to_string(dict_get_or(cfg, "vector_backend_qdrant_url", "")))
	if ends_with(url, "/") {
		url = substring(url, 0, len(url) - 1)
	}
	return url
}

func qdrant_mirror_path(cfg) {
	configured_path := trim(to_string(dict_get_or(cfg, "vector_backend_qdrant_mirror_path", "")))
	if configured_path != "" {
		return configured_path
	}
	key := qdrant_collection_name(cfg)
	hash := substring(sha256(key), 0, 16)
	return "./results/vector_backend_qdrant__" + hash + ".json"
}

func qdrant_header_file(cfg, collection) {
	header_file_path := qdrant_tmp_file_path("qdrant_headers", collection, ".txt")
	lines := ["Content-Type: application/json"]
	api_key := trim(to_string(dict_get_or(cfg, "vector_backend_qdrant_api_key", "")))
	if api_key != "" {
		lines = push(lines, "api-key: " + api_key)
	}
	write_file(header_file_path, join(lines, "\n") + "\n")
	_ = execute_status("chmod 600 " + shell_quote(header_file_path), {"timeout_ms": 5000})
	return header_file_path
}

func qdrant_tmp_file_path(prefix, collection, suffix) {
	id := substring(sha256(prefix + ":" + collection + ":" + to_string(current_timestamp())), 0, 16)
	return "/tmp/kujo_rag_" + prefix + "_" + id + suffix
}

func qdrant_points_payload(index) {
	chunk_lookup := {}
	for chunk in dict_get_or(index, "chunks", []) {
		chunk_lookup[dict_get_or(chunk, "chunk_id", "")] := chunk
	}

	points := []
	point_id := 1
	for entry in dict_get_or(index, "vectors", []) {
		chunk_id := dict_get_or(entry, "chunk_id", "")
		embedding := dict_get_or(entry, "embedding", [])
		if type(embedding) == "array" && len(embedding) > 0 {
			chunk := dict_get_or(chunk_lookup, chunk_id, {})
			points = push(points, {
				"id": point_id,
				"vector": embedding,
				"payload": {
					"chunk_id": chunk_id,
					"doc_id": dict_get_or(chunk, "doc_id", ""),
					"path": dict_get_or(chunk, "path", ""),
					"line_start": dict_get_or(chunk, "line_start", 1),
					"line_end": dict_get_or(chunk, "line_end", 1),
					"text": dict_get_or(chunk, "text", "")
				}
			})
			point_id = point_id + 1
		}
	}

	return points
}

func qdrant_tagged_points(index) {
	points := qdrant_points_payload(index)
	generation_digest := sha256(to_json(points))
	tagged := []
	for point in points {
		payload := dict_get_or(point, "payload", {})
		payload["_kujo_generation_digest"] := generation_digest
		point["payload"] := payload
		tagged = push(tagged, point)
	}
	return {"points": tagged, "generation_digest": generation_digest}
}

func qdrant_sync_index_legacy(cfg, index) {
	if qdrant_sync_enabled(cfg) == false {
		return {
			"ok": true,
			"synced": false,
			"reason": "sync_disabled"
		}
	}

	base_url := qdrant_base_url(cfg)
	if base_url == "" {
		return {
			"ok": false,
			"error": {
				"code": "qdrant_url_missing",
				"message": "Qdrant sync requires non-empty vector_backend_qdrant_url"
			}
		}
	}

	collection := qdrant_collection_name(cfg)
	points := qdrant_points_payload(index)

	if path_exists("./results") == false {
		create_dir("./results")
	}

	header_path := qdrant_header_file(cfg, collection)
	timeout_ms := qdrant_timeout_ms(cfg)
	timeout_sec := timeout_ms / 1000
	if timeout_sec < 1 {
		timeout_sec = 1
	}
	headers := "-H @" + shell_quote(header_path)
	delete_cmd := "curl --silent --show-error --max-time " + to_string(timeout_sec) + " --output /dev/null --write-out '%{http_code}' -X DELETE " + headers + " " + shell_quote(base_url + "/collections/" + collection)
	delete_result := execute_status(delete_cmd, {"timeout_ms": timeout_ms + 2000})
	delete_status := trim(command_stdout(delete_result))
	delete_ok := command_success(delete_result) && (starts_with(delete_status, "2") || delete_status == "404")
	if delete_ok == false {
		remove_file_if_exists(header_path)
		return {
			"ok": false,
			"error": {
				"code": "qdrant_collection_reset_failed",
				"message": "Failed to reset Qdrant collection before authoritative synchronization",
				"details": {
					"collection": collection,
					"http_status": delete_status,
					"stderr": command_stderr(delete_result)
				}
			}
		}
	}

	if len(points) == 0 {
		remove_file_if_exists(header_path)
		return {
			"ok": true,
			"synced": true,
			"reason": "collection_cleared",
			"collection": collection,
			"points_synced": 0
		}
	}

	dims := len(dict_get_or(points[0], "vector", []))
	if dims <= 0 {
		remove_file_if_exists(header_path)
		return {
			"ok": false,
			"error": {
				"code": "qdrant_vector_dimensions_invalid",
				"message": "Qdrant synchronization requires non-empty vector dimensions"
			}
		}
	}

	meta_payload_path := qdrant_tmp_file_path("qdrant_collection", collection, ".json")
	points_payload_path := qdrant_tmp_file_path("qdrant_points", collection, ".json")

	write_json_file(meta_payload_path, {
		"vectors": {
			"size": dims,
			"distance": "Cosine"
		}
	})
	write_json_file(points_payload_path, {
		"points": points
	})
	_ = execute_status("chmod 600 " + shell_quote(meta_payload_path) + " " + shell_quote(points_payload_path), {"timeout_ms": 5000})

	create_cmd := "curl --silent --show-error --fail-with-body --max-time " + to_string(timeout_sec) + " -X PUT " + headers + " --data-binary @" + shell_quote(meta_payload_path) + " " + shell_quote(base_url + "/collections/" + collection)
	create_result := execute_status(create_cmd, {"timeout_ms": timeout_ms + 2000})
	if command_success(create_result) == false {
		remove_file_if_exists(meta_payload_path)
		remove_file_if_exists(points_payload_path)
		remove_file_if_exists(header_path)
		return {
			"ok": false,
			"error": {
				"code": "qdrant_collection_create_failed",
				"message": "Failed to create or update Qdrant collection",
				"details": {
					"collection": collection,
					"stderr": command_stderr(create_result),
					"stdout": command_stdout(create_result)
				}
			}
		}
	}

	upsert_cmd := "curl --silent --show-error --fail-with-body --max-time " + to_string(timeout_sec) + " -X PUT " + headers + " --data-binary @" + shell_quote(points_payload_path) + " " + shell_quote(base_url + "/collections/" + collection + "/points?wait=true")
	upsert_result := execute_status(upsert_cmd, {"timeout_ms": timeout_ms + 2000})

	remove_file_if_exists(meta_payload_path)
	remove_file_if_exists(points_payload_path)
	remove_file_if_exists(header_path)

	if command_success(upsert_result) == false {
		return {
			"ok": false,
			"error": {
				"code": "qdrant_points_upsert_failed",
				"message": "Failed to upsert vectors into Qdrant collection",
				"details": {
					"collection": collection,
					"stderr": command_stderr(upsert_result),
					"stdout": command_stdout(upsert_result)
				}
			}
		}
	}

	return {
		"ok": true,
		"synced": true,
		"collection": collection,
		"points_synced": len(points)
	}
}

func qdrant_sync_mode(cfg) {
	mode := to_lower(trim(to_string(dict_get_or(cfg, "vector_backend_qdrant_sync_mode", "legacy_replace"))))
	if mode == "staged_alias" || mode == "legacy_replace" {
		return mode
	}
	return "invalid"
}

func qdrant_alias_name(cfg) {
	configured := to_lower(trim(to_string(dict_get_or(cfg, "vector_backend_qdrant_alias", ""))))
	if configured == "" {
		configured = qdrant_collection_name(cfg) + "__active"
	}
	invalid := regex_replace(configured, "[a-z0-9_-]", "")
	if invalid != "" {
		configured = "alias_" + substring(sha256(configured), 0, 10)
	}
	return configured
}

func qdrant_journal_path(cfg) {
	configured := trim(to_string(dict_get_or(cfg, "vector_backend_qdrant_journal_path", "")))
	if configured != "" {
		return configured
	}
	return qdrant_mirror_path(cfg) + ".qdrant-journal.json"
}

func qdrant_candidate_mirror_path(cfg) {
	return qdrant_journal_path(cfg) + ".candidate.json"
}

func qdrant_phase_is_terminal(phase) {
	return phase == "" || phase == "mirror_committed" || phase == "aborted_cleaned" || phase == "candidate_abandoned" || phase == "rolled_back"
}

func qdrant_gc_enabled(cfg) {
	return bool_or(dict_get_or(cfg, "vector_backend_qdrant_gc_enabled", false), false)
}

func qdrant_gc_grace_ms(cfg) {
	seconds := num_or(dict_get_or(cfg, "vector_backend_qdrant_gc_grace_sec", 86400), 86400)
	if seconds < 60 {
		seconds = 60
	}
	if seconds > 2592000 {
		seconds = 2592000
	}
	return seconds * 1000
}

func qdrant_gc_max_per_save(cfg) {
	limit := num_or(dict_get_or(cfg, "vector_backend_qdrant_gc_max_per_save", 1), 1)
	if limit < 1 {
		limit = 1
	}
	if limit > 10 {
		limit = 10
	}
	return limit
}

func qdrant_pending_add(cfg, pending, collection, reason) {
	if collection == "" {
		return pending
	}
	for entry in pending {
		if to_string(dict_get_or(entry, "collection", "")) == collection {
			return pending
		}
	}
	now_ms := current_timestamp()
	return push(pending, {"collection": collection, "reason": reason, "recorded_at_unix_ms": now_ms, "eligible_after_unix_ms": now_ms + qdrant_gc_grace_ms(cfg)})
}

func qdrant_write_journal(cfg, journal) {
	journal_file_path := qdrant_journal_path(cfg)
	dir := dirname(journal_file_path)
	if dir != "" && dir != "." && path_exists(dir) == false {
		create_dir(dir)
	}
	written := false
	write_error := null
	try {
		written = write_file_atomic(journal_file_path, to_json(journal), true)
	} except e {
		write_error = e
	}
	if type(write_error) != "null" || written != true {
		return {
			"ok": false,
			"error": {
				"code": "qdrant_journal_write_failed",
				"message": "Failed to persist the Qdrant recovery journal before remote mutation",
				"details": {"path": journal_file_path, "runtime_error": substring(to_string(write_error), 0, 512)}
			}
		}
	}
	return {"ok": true, "path": journal_file_path}
}

func qdrant_request(cfg, header_path, method, url, payload_path) {
	timeout_ms := qdrant_timeout_ms(cfg)
	timeout_sec := timeout_ms / 1000
	if timeout_sec < 1 {
		timeout_sec = 1
	}
	response_path := qdrant_tmp_file_path("qdrant_response", qdrant_collection_name(cfg), ".json")
	cmd := "curl --silent --show-error --max-time " + to_string(timeout_sec) + " --output " + shell_quote(response_path) + " --write-out '%{http_code}' -X " + method + " -H @" + shell_quote(header_path)
	if payload_path != "" {
		cmd = cmd + " --data-binary @" + shell_quote(payload_path)
	}
	cmd = cmd + " " + shell_quote(url)
	result := execute_status(cmd, {"timeout_ms": timeout_ms + 2000})
	status := trim(command_stdout(result))
	body := ""
	if file_exists(response_path) {
		body = read_file(response_path)
		remove_file_if_exists(response_path)
	}
	request_ok := command_success(result) && starts_with(status, "2")
	return {
		"ok": request_ok,
		"status": status,
		"body": body,
		"stderr": command_stderr(result)
	}
}

func qdrant_parse_response(response) {
	body := dict_get_or(response, "body", "")
	if type(body) != "string" || trim(body) == "" {
		return {}
	}
	parsed := {}
	parse_error := null
	try {
		parsed = parse_json(body)
	} except e {
		parse_error = e
	}
	if type(parse_error) != "null" || type(parsed) != "dict" {
		return {}
	}
	return parsed
}

func qdrant_existing_alias_target(cfg, header_path, alias_name) {
	response := qdrant_request(cfg, header_path, "GET", qdrant_base_url(cfg) + "/aliases", "")
	if dict_get_or(response, "ok", false) == false {
		return {"ok": false, "response": response}
	}
	parsed := qdrant_parse_response(response)
	aliases := dict_get_or(dict_get_or(parsed, "result", {}), "aliases", [])
	for alias_record in aliases {
		if to_string(dict_get_or(alias_record, "alias_name", "")) == alias_name {
			return {"ok": true, "target": to_string(dict_get_or(alias_record, "collection_name", ""))}
		}
	}
	return {"ok": true, "target": ""}
}

func qdrant_fail_staged(cfg, journal, code, message, details) {
	journal["phase"] := "failed"
	journal["error"] := {"code": code, "message": message, "details": details}
	journal["updated_at_unix_ms"] := current_timestamp()
	_ = qdrant_write_journal(cfg, journal)
	return {"ok": false, "error": journal["error"]}
}

func qdrant_recover_staged_transaction(cfg) {
	recovery_journal := read_json_file_or(qdrant_journal_path(cfg), {})
	recovery_phase := to_string(dict_get_or(recovery_journal, "phase", ""))
	if qdrant_phase_is_terminal(recovery_phase) {
		return {"ok": true, "recovered": false, "phase": recovery_phase}
	}
	if qdrant_sync_enabled(cfg) == false || qdrant_base_url(cfg) == "" {
		return {"ok": false, "error": {"code": "qdrant_recovery_connection_required", "message": "An unresolved staged transaction requires an enabled Qdrant connection", "details": {"phase": recovery_phase, "journal_path": qdrant_journal_path(cfg)}}}
	}

	recovery_alias := to_string(dict_get_or(recovery_journal, "alias", qdrant_alias_name(cfg)))
	recovery_candidate := to_string(dict_get_or(recovery_journal, "candidate_collection", ""))
	recovery_previous := to_string(dict_get_or(recovery_journal, "previous_collection", ""))
	recovery_header_path := qdrant_header_file(cfg, qdrant_collection_name(cfg))
	recovery_alias_result := qdrant_existing_alias_target(cfg, recovery_header_path, recovery_alias)
	remove_file_if_exists(recovery_header_path)
	if dict_get_or(recovery_alias_result, "ok", false) == false {
		return {"ok": false, "error": {"code": "qdrant_recovery_alias_lookup_failed", "message": "Could not resolve the active alias while recovering a staged transaction", "details": recovery_alias_result}}
	}
	recovery_active := to_string(dict_get_or(recovery_alias_result, "target", ""))

	if recovery_candidate != "" && recovery_active == recovery_candidate {
		recovery_candidate_path := to_string(dict_get_or(recovery_journal, "candidate_mirror_path", qdrant_candidate_mirror_path(cfg)))
		if file_exists(recovery_candidate_path) == false {
			return {"ok": false, "error": {"code": "qdrant_recovery_candidate_missing", "message": "The alias points to the candidate but its durable local mirror is missing", "details": {"candidate_collection": recovery_candidate, "candidate_mirror_path": recovery_candidate_path}}}
		}
		recovery_index := load_index_with_config(recovery_candidate_path, cfg)
		recovery_load_error := dict_get_or(dict_get_or(recovery_index, "meta", {}), "load_error", null)
		if type(recovery_load_error) == "dict" {
			return {"ok": false, "error": {"code": "qdrant_recovery_candidate_invalid", "message": "The durable candidate mirror failed validation", "details": recovery_load_error}}
		}
		recovery_saved := save_index_with_config(qdrant_mirror_path(cfg), recovery_index, cfg)
		if recovery_saved == false {
			return {"ok": false, "error": {"code": "qdrant_recovery_mirror_commit_failed", "message": "The alias points to the candidate but its local mirror could not be committed"}}
		}
		recovery_journal["phase"] := "mirror_committed"
		recovery_journal["recovery_action"] := "completed_forward"
		recovery_journal["mirror_path"] := qdrant_mirror_path(cfg)
		recovery_journal["mirror_committed_at_unix_ms"] := current_timestamp()
		recovery_journal["updated_at_unix_ms"] := current_timestamp()
		recovery_write := qdrant_write_journal(cfg, recovery_journal)
		if dict_get_or(recovery_write, "ok", false) == false {
			return recovery_write
		}
		remove_file_if_exists(recovery_candidate_path)
		return {"ok": true, "recovered": true, "phase": "mirror_committed", "action": "completed_forward"}
	}

	may_have_committed := recovery_phase == "alias_commit_started" || recovery_phase == "alias_commit_ambiguous" || recovery_phase == "alias_committed"
	if may_have_committed && recovery_active != recovery_previous {
		return {"ok": false, "error": {"code": "qdrant_concurrent_writer_detected", "message": "The active alias matches neither the candidate nor the recorded previous generation", "details": {"active_collection": recovery_active, "candidate_collection": recovery_candidate, "previous_collection": recovery_previous}}}
	}

	gc_pending := dict_get_or(recovery_journal, "gc_pending", [])
	gc_pending = qdrant_pending_add(cfg, gc_pending, recovery_candidate, "aborted_candidate")
	recovery_journal["gc_pending"] := gc_pending
	recovery_journal["phase"] := "candidate_abandoned"
	recovery_journal["recovery_action"] := "preserved_active_alias"
	recovery_journal["updated_at_unix_ms"] := current_timestamp()
	recovery_write := qdrant_write_journal(cfg, recovery_journal)
	if dict_get_or(recovery_write, "ok", false) == false {
		return recovery_write
	}
	remove_file_if_exists(to_string(dict_get_or(recovery_journal, "candidate_mirror_path", qdrant_candidate_mirror_path(cfg))))
	return {"ok": true, "recovered": true, "phase": "candidate_abandoned", "action": "preserved_active_alias"}
}

func qdrant_gc_staged_generations(cfg, gc_journal) {
	if qdrant_gc_enabled(cfg) == false {
		return {"ok": true, "enabled": false, "deleted": []}
	}
	pending := dict_get_or(gc_journal, "gc_pending", [])
	if type(pending) != "array" || len(pending) == 0 {
		return {"ok": true, "enabled": true, "deleted": []}
	}
	gc_header_path := qdrant_header_file(cfg, qdrant_collection_name(cfg))
	gc_alias_result := qdrant_existing_alias_target(cfg, gc_header_path, qdrant_alias_name(cfg))
	if dict_get_or(gc_alias_result, "ok", false) == false {
		remove_file_if_exists(gc_header_path)
		return {"ok": false, "error": {"code": "qdrant_gc_alias_lookup_failed", "message": "Generation GC could not verify the active alias", "details": gc_alias_result}}
	}
	active_collection := to_string(dict_get_or(gc_alias_result, "target", ""))
	managed_prefix := qdrant_collection_name(cfg) + "__gen_"
	remaining := []
	deleted := []
	delete_limit := qdrant_gc_max_per_save(cfg)
	now_ms := current_timestamp()
	for entry in pending {
		candidate_collection := to_string(dict_get_or(entry, "collection", ""))
		eligible_after := num_or(dict_get_or(entry, "eligible_after_unix_ms", now_ms + qdrant_gc_grace_ms(cfg)), now_ms + qdrant_gc_grace_ms(cfg))
		eligible := starts_with(candidate_collection, managed_prefix) && candidate_collection != active_collection && eligible_after <= now_ms && len(deleted) < delete_limit
		if eligible {
			delete_response := qdrant_request(cfg, gc_header_path, "DELETE", qdrant_base_url(cfg) + "/collections/" + candidate_collection, "")
			delete_status := to_string(dict_get_or(delete_response, "status", ""))
			if dict_get_or(delete_response, "ok", false) || delete_status == "404" {
				deleted = push(deleted, candidate_collection)
			} else {
				remaining = push(remaining, entry)
			}
		} else {
			remaining = push(remaining, entry)
		}
	}
	remove_file_if_exists(gc_header_path)
	gc_journal["gc_pending"] := remaining
	gc_journal["gc_last_run_at_unix_ms"] := current_timestamp()
	gc_journal["gc_last_deleted"] := deleted
	gc_write := qdrant_write_journal(cfg, gc_journal)
	if dict_get_or(gc_write, "ok", false) == false {
		return gc_write
	}
	return {"ok": true, "enabled": true, "deleted": deleted, "remaining": len(remaining)}
}

func qdrant_sync_index_staged(cfg, index) {
	if qdrant_sync_enabled(cfg) == false {
		return {"ok": true, "synced": false, "reason": "sync_disabled"}
	}
	base_url := qdrant_base_url(cfg)
	if base_url == "" {
		return {"ok": false, "error": {"code": "qdrant_url_missing", "message": "Qdrant sync requires non-empty vector_backend_qdrant_url"}}
	}
	existing_journal := read_json_file_or(qdrant_journal_path(cfg), {})
	existing_phase := to_string(dict_get_or(existing_journal, "phase", ""))
	if qdrant_phase_is_terminal(existing_phase) == false {
		recovery_result := qdrant_recover_staged_transaction(cfg)
		if dict_get_or(recovery_result, "ok", false) == false {
			return recovery_result
		}
		existing_journal = read_json_file_or(qdrant_journal_path(cfg), {})
	}
	_ = qdrant_gc_staged_generations(cfg, existing_journal)
	existing_journal = read_json_file_or(qdrant_journal_path(cfg), existing_journal)

	collection := qdrant_collection_name(cfg)
	alias_name := qdrant_alias_name(cfg)
	tagged_points := qdrant_tagged_points(index)
	points := dict_get_or(tagged_points, "points", [])
	generation_digest := dict_get_or(tagged_points, "generation_digest", "")
	dims := num_or(dict_get_or(cfg, "embedding_dims", 0), 0)
	if len(points) > 0 {
		dims = len(dict_get_or(points[0], "vector", []))
	}
	if dims <= 0 {
		return {"ok": false, "error": {"code": "qdrant_vector_dimensions_invalid", "message": "Staged Qdrant synchronization requires a positive vector dimension"}}
	}

	generation_id := substring(sha256(to_json(index)), 0, 12) + "_" + to_string(current_timestamp())
	base_prefix := collection
	if len(base_prefix) > 48 {
		base_prefix = substring(base_prefix, 0, 48)
	}
	generation := base_prefix + "__gen_" + generation_id
	candidate_mirror_path := qdrant_candidate_mirror_path(cfg)
	candidate_meta := dict_get_or(index, "meta", {})
	candidate_meta["backend"] := "qdrant_http"
	candidate_meta["qdrant_alias"] := alias_name
	candidate_meta["qdrant_generation"] := generation
	candidate_meta["qdrant_generation_digest"] := generation_digest
	index["meta"] := candidate_meta
	candidate_persist := persist_index_with_config(candidate_mirror_path, index, cfg)
	if dict_get_or(candidate_persist, "ok", false) == false {
		return {"ok": false, "error": {"code": "qdrant_candidate_mirror_persistence_failed", "message": "The staged local mirror could not be persisted before remote mutation", "details": candidate_persist}}
	}
	journal := {
		"schema_version": 1,
		"mode": "staged_alias",
		"phase": "prepared",
		"logical_collection": collection,
		"alias": alias_name,
		"candidate_collection": generation,
		"expected_points": len(points),
		"vector_dimensions": dims,
		"generation_digest": generation_digest,
		"candidate_mirror_path": candidate_mirror_path,
		"candidate_mirror_sha256": dict_get_or(candidate_persist, "sha256", ""),
		"gc_pending": dict_get_or(existing_journal, "gc_pending", []),
		"gc_last_run_at_unix_ms": dict_get_or(existing_journal, "gc_last_run_at_unix_ms", 0),
		"gc_last_deleted": dict_get_or(existing_journal, "gc_last_deleted", []),
		"created_at_unix_ms": current_timestamp(),
		"updated_at_unix_ms": current_timestamp()
	}
	journal_write := qdrant_write_journal(cfg, journal)
	if dict_get_or(journal_write, "ok", false) == false {
		return journal_write
	}

	header_path := qdrant_header_file(cfg, collection)
	meta_payload_path := qdrant_tmp_file_path("qdrant_collection", generation, ".json")
	points_payload_path := qdrant_tmp_file_path("qdrant_points", generation, ".json")
	count_payload_path := qdrant_tmp_file_path("qdrant_count", generation, ".json")
	digest_count_payload_path := qdrant_tmp_file_path("qdrant_digest_count", generation, ".json")
	alias_payload_path := qdrant_tmp_file_path("qdrant_alias", generation, ".json")
	write_json_file(meta_payload_path, {"vectors": {"size": dims, "distance": "Cosine"}})
	write_json_file(points_payload_path, {"points": points})
	write_json_file(count_payload_path, {"exact": true})
	write_json_file(digest_count_payload_path, {"exact": true, "filter": {"must": [{"key": "_kujo_generation_digest", "match": {"value": generation_digest}}]}})
	_ = execute_status("chmod 600 " + shell_quote(meta_payload_path) + " " + shell_quote(points_payload_path) + " " + shell_quote(count_payload_path) + " " + shell_quote(digest_count_payload_path), {"timeout_ms": 5000})

	create_response := qdrant_request(cfg, header_path, "PUT", base_url + "/collections/" + generation, meta_payload_path)
	if dict_get_or(create_response, "ok", false) == false {
		remove_file_if_exists(meta_payload_path)
		remove_file_if_exists(points_payload_path)
		remove_file_if_exists(count_payload_path)
		remove_file_if_exists(digest_count_payload_path)
		remove_file_if_exists(header_path)
		return qdrant_fail_staged(cfg, journal, "qdrant_candidate_create_failed", "Failed to create the staged Qdrant collection", create_response)
	}
	journal["phase"] := "candidate_created"
	journal["updated_at_unix_ms"] := current_timestamp()
	journal_write = qdrant_write_journal(cfg, journal)
	if dict_get_or(journal_write, "ok", false) == false {
		remove_file_if_exists(meta_payload_path)
		remove_file_if_exists(points_payload_path)
		remove_file_if_exists(count_payload_path)
		remove_file_if_exists(digest_count_payload_path)
		remove_file_if_exists(header_path)
		return journal_write
	}

	if len(points) > 0 {
		upsert_response := qdrant_request(cfg, header_path, "PUT", base_url + "/collections/" + generation + "/points?wait=true", points_payload_path)
		if dict_get_or(upsert_response, "ok", false) == false {
			remove_file_if_exists(meta_payload_path)
			remove_file_if_exists(points_payload_path)
			remove_file_if_exists(count_payload_path)
			remove_file_if_exists(digest_count_payload_path)
			remove_file_if_exists(header_path)
			return qdrant_fail_staged(cfg, journal, "qdrant_candidate_upsert_failed", "Failed to populate the staged Qdrant collection", upsert_response)
		}
	}
	journal["phase"] := "candidate_uploaded"
	journal["updated_at_unix_ms"] := current_timestamp()
	journal_write = qdrant_write_journal(cfg, journal)
	if dict_get_or(journal_write, "ok", false) == false {
		remove_file_if_exists(meta_payload_path)
		remove_file_if_exists(points_payload_path)
		remove_file_if_exists(count_payload_path)
		remove_file_if_exists(digest_count_payload_path)
		remove_file_if_exists(header_path)
		return journal_write
	}

	count_response := qdrant_request(cfg, header_path, "POST", base_url + "/collections/" + generation + "/points/count", count_payload_path)
	count_parsed := qdrant_parse_response(count_response)
	actual_points := num_or(dict_get_or(dict_get_or(count_parsed, "result", {}), "count", -1), -1)
	digest_count_response := qdrant_request(cfg, header_path, "POST", base_url + "/collections/" + generation + "/points/count", digest_count_payload_path)
	digest_count_parsed := qdrant_parse_response(digest_count_response)
	digest_points := num_or(dict_get_or(dict_get_or(digest_count_parsed, "result", {}), "count", -1), -1)
	if dict_get_or(count_response, "ok", false) == false || actual_points != len(points) || dict_get_or(digest_count_response, "ok", false) == false || digest_points != len(points) {
		remove_file_if_exists(meta_payload_path)
		remove_file_if_exists(points_payload_path)
		remove_file_if_exists(count_payload_path)
		remove_file_if_exists(digest_count_payload_path)
		remove_file_if_exists(header_path)
		return qdrant_fail_staged(cfg, journal, "qdrant_candidate_verification_failed", "Staged Qdrant collection did not match the expected point count and generation digest", {"expected": len(points), "actual": actual_points, "digest_actual": digest_points, "count_response": count_response, "digest_response": digest_count_response})
	}
	journal["phase"] := "candidate_verified"
	journal["updated_at_unix_ms"] := current_timestamp()
	journal_write = qdrant_write_journal(cfg, journal)
	if dict_get_or(journal_write, "ok", false) == false {
		remove_file_if_exists(meta_payload_path)
		remove_file_if_exists(points_payload_path)
		remove_file_if_exists(count_payload_path)
		remove_file_if_exists(digest_count_payload_path)
		remove_file_if_exists(header_path)
		return journal_write
	}

	previous_result := qdrant_existing_alias_target(cfg, header_path, alias_name)
	if dict_get_or(previous_result, "ok", false) == false {
		remove_file_if_exists(meta_payload_path)
		remove_file_if_exists(points_payload_path)
		remove_file_if_exists(count_payload_path)
		remove_file_if_exists(digest_count_payload_path)
		remove_file_if_exists(header_path)
		return qdrant_fail_staged(cfg, journal, "qdrant_alias_lookup_failed", "Failed to resolve the active Qdrant alias before commit", previous_result)
	}
	previous_target := to_string(dict_get_or(previous_result, "target", ""))
	actions := []
	if previous_target != "" {
		actions = push(actions, {"delete_alias": {"alias_name": alias_name}})
	}
	actions = push(actions, {"create_alias": {"collection_name": generation, "alias_name": alias_name}})
	write_json_file(alias_payload_path, {"actions": actions})
	_ = execute_status("chmod 600 " + shell_quote(alias_payload_path), {"timeout_ms": 5000})
	journal["phase"] := "alias_commit_started"
	journal["previous_collection"] := previous_target
	journal["alias_commit_started_at_unix_ms"] := current_timestamp()
	journal["updated_at_unix_ms"] := current_timestamp()
	journal_write = qdrant_write_journal(cfg, journal)
	if dict_get_or(journal_write, "ok", false) == false {
		remove_file_if_exists(meta_payload_path)
		remove_file_if_exists(points_payload_path)
		remove_file_if_exists(count_payload_path)
		remove_file_if_exists(digest_count_payload_path)
		remove_file_if_exists(alias_payload_path)
		remove_file_if_exists(header_path)
		return journal_write
	}
	alias_response := qdrant_request(cfg, header_path, "POST", base_url + "/collections/aliases", alias_payload_path)

	remove_file_if_exists(meta_payload_path)
	remove_file_if_exists(points_payload_path)
	remove_file_if_exists(count_payload_path)
	remove_file_if_exists(digest_count_payload_path)
	remove_file_if_exists(alias_payload_path)
	remove_file_if_exists(header_path)
	if dict_get_or(alias_response, "ok", false) == false {
		journal["phase"] := "alias_commit_ambiguous"
		journal["error"] := {"code": "qdrant_alias_commit_ambiguous", "message": "The alias request did not return success; remote commit state must be reconciled", "details": alias_response}
		journal["updated_at_unix_ms"] := current_timestamp()
		_ = qdrant_write_journal(cfg, journal)
		return {"ok": false, "error": journal["error"]}
	}

	journal["phase"] := "alias_committed"
	journal["previous_collection"] := previous_target
	if previous_target != "" {
		pending_generations := dict_get_or(journal, "gc_pending", [])
		pending_generations = qdrant_pending_add(cfg, pending_generations, previous_target, "superseded_generation")
		journal["gc_pending"] := pending_generations
	}
	journal["committed_at_unix_ms"] := current_timestamp()
	journal["updated_at_unix_ms"] := current_timestamp()
	journal_write = qdrant_write_journal(cfg, journal)
	if dict_get_or(journal_write, "ok", false) == false {
		return journal_write
	}
	return {
		"ok": true,
		"synced": true,
		"collection": collection,
		"alias": alias_name,
		"generation": generation,
		"previous_collection": previous_target,
		"points_synced": len(points),
		"reason": "staged_alias_committed"
	}
}

func qdrant_sync_index(cfg, index) {
	if qdrant_sync_mode(cfg) == "staged_alias" {
		return qdrant_sync_index_staged(cfg, index)
	}
	if qdrant_sync_mode(cfg) != "legacy_replace" {
		return {"ok": false, "error": {"code": "invalid_qdrant_sync_mode", "message": "Qdrant synchronization refused an unknown sync mode"}}
	}
	return qdrant_sync_index_legacy(cfg, index)
}

func qdrant_load(cfg) {
	collection := qdrant_collection_name(cfg)
	path := qdrant_mirror_path(cfg)
	recovery_result := {"ok": true, "recovered": false}
	if qdrant_sync_mode(cfg) == "staged_alias" {
		recovery_result = qdrant_recover_staged_transaction(cfg)
	}
	loaded := load_index_with_config(path, cfg)
	meta := dict_get_or(loaded, "meta", {})
	meta["backend"] := "qdrant_http"
	meta["qdrant_collection"] := collection
	meta["qdrant_sync_enabled"] := qdrant_sync_enabled(cfg)
	if qdrant_sync_mode(cfg) == "staged_alias" {
		meta["qdrant_alias"] := qdrant_alias_name(cfg)
		journal := read_json_file_or(qdrant_journal_path(cfg), {})
		phase := to_string(dict_get_or(journal, "phase", ""))
		if phase != "" {
			meta["qdrant_journal_phase"] := phase
			meta["qdrant_generation"] := dict_get_or(journal, "candidate_collection", "")
		}
		if phase != "" && phase != "mirror_committed" && phase != "aborted_cleaned" {
			meta["qdrant_recovery_required"] := true
		}
		if phase == "alias_commit_started" || phase == "alias_commit_ambiguous" || phase == "alias_committed" {
			meta["load_error"] := {
				"code": "qdrant_recovery_required",
				"message": "The remote alias may have committed while the local mirror did not; perform operator recovery before another save",
				"details": {"journal_path": qdrant_journal_path(cfg), "candidate_collection": dict_get_or(journal, "candidate_collection", "")}
			}
		}
		if dict_get_or(recovery_result, "ok", true) == false {
			meta["load_error"] := dict_get_or(recovery_result, "error", {"code": "qdrant_recovery_failed", "message": "Staged Qdrant recovery failed"})
		}
	}
	loaded["meta"] := meta
	return loaded
}

func qdrant_save(cfg, index) {
	collection := qdrant_collection_name(cfg)
	path := qdrant_mirror_path(cfg)
	dir := dirname(path)
	if dir != "" && dir != "." && path_exists(dir) == false {
		create_dir(dir)
	}

	sync_result := qdrant_sync_index(cfg, index)
	meta := dict_get_or(index, "meta", {})
	meta["backend"] := "qdrant_http"
	meta["qdrant_collection"] := collection
	meta["qdrant_sync_enabled"] := qdrant_sync_enabled(cfg)
	meta["qdrant_mirror_path"] := path
	meta["qdrant_last_sync_at"] := current_timestamp()
	if dict_get_or(sync_result, "ok", false) == true {
		meta["qdrant_last_sync_ok"] := true
		meta["qdrant_last_sync_reason"] := dict_get_or(sync_result, "reason", "synced")
		meta["qdrant_points_synced"] := dict_get_or(sync_result, "points_synced", 0)
		if qdrant_sync_mode(cfg) == "staged_alias" {
			meta["qdrant_alias"] := dict_get_or(sync_result, "alias", qdrant_alias_name(cfg))
			meta["qdrant_generation"] := dict_get_or(sync_result, "generation", "")
			meta["qdrant_previous_generation"] := dict_get_or(sync_result, "previous_collection", "")
		}
	} else {
		meta["qdrant_last_sync_ok"] := false
		error_payload := dict_get_or(sync_result, "error", {})
		meta["qdrant_last_sync_reason"] := dict_get_or(error_payload, "code", "qdrant_sync_failed")
	}
	index["meta"] := meta
	if dict_get_or(sync_result, "ok", false) == false && qdrant_fail_open(cfg) == false {
		return false
	}

	saved := save_index_with_config(path, index, cfg)
	if saved == false {
		return false
	}
	if qdrant_sync_mode(cfg) == "staged_alias" && dict_get_or(sync_result, "ok", false) == true {
		journal := read_json_file_or(qdrant_journal_path(cfg), {})
		if type(journal) == "dict" && dict_get_or(journal, "candidate_collection", "") == dict_get_or(sync_result, "generation", "") {
			journal["phase"] := "mirror_committed"
			journal["mirror_path"] := path
			journal["mirror_committed_at_unix_ms"] := current_timestamp()
			journal["updated_at_unix_ms"] := current_timestamp()
			journal_write := qdrant_write_journal(cfg, journal)
			if dict_get_or(journal_write, "ok", false) == false {
				return false
			}
			remove_file_if_exists(to_string(dict_get_or(journal, "candidate_mirror_path", qdrant_candidate_mirror_path(cfg))))
		}
	}

	return true
}

func memory_load(cfg) {
	key := memory_store_key(cfg)
	path := memory_backend_path(cfg)
	loaded := load_index_with_config(path, cfg)
	meta := dict_get_or(loaded, "meta", {})
	meta["backend"] := "memory"
	meta["memory_key"] := key
	loaded["meta"] := meta
	return loaded
}

func memory_save(cfg, index) {
	key := memory_store_key(cfg)
	path := memory_backend_path(cfg)
	if path_exists("./results") == false {
		create_dir("./results")
	}
	meta := dict_get_or(index, "meta", {})
	meta["backend"] := "memory"
	meta["memory_key"] := key
	index["meta"] := meta
	return save_index_with_config(path, index, cfg)
}

export get_vector_backend_registry := func() {
	return {
		"local_json": {
			"name": "local_json",
			"description": "Default JSON index backend persisted at KUJO_RAG_INDEX_PATH",
			"persistence": "disk"
		},
		"memory": {
			"name": "memory",
			"description": "Reference adapter scaffold with key-scoped persisted state",
			"persistence": "scaffold"
		},
		"qdrant_http": {
			"name": "qdrant_http",
			"description": "Qdrant-compatible ANN adapter with local mirror persistence and optional remote sync",
			"persistence": "external_ann_mirror"
		}
	}
}

export load_index_with_backend := func(cfg) {
	backend_name := normalize_backend_name(cfg)
	if backend_name == "memory" {
		return memory_load(cfg)
	}
	if backend_name == "qdrant_http" {
		return qdrant_load(cfg)
	}
	return local_json_load(cfg)
}

export save_index_with_backend := func(cfg, index) {
	backend_name := normalize_backend_name(cfg)
	if backend_name == "memory" {
		return memory_save(cfg, index)
	}
	if backend_name == "qdrant_http" {
		return qdrant_save(cfg, index)
	}
	return local_json_save(cfg, index)
}

export persist_index_with_backend := func(cfg, index) {
	backend_name := normalize_backend_name(cfg)
	if backend_name == "local_json" {
		path := dict_get_or(cfg, "index_path", "./data/rag_index.json")
		return persist_index_with_config(path, index, cfg)
	}

	saved := save_index_with_backend(cfg, index)
	if saved == true {
		return {"ok": true, "backend": backend_name}
	}
	return {
		"ok": false,
		"error": {
			"code": "index_backend_persistence_failed",
			"message": "Vector backend did not persist the index",
			"details": {"backend": backend_name}
		}
	}
}

export active_backend_summary := func(cfg) {
	registry := get_vector_backend_registry()
	name := normalize_backend_name(cfg)
	entry := dict_get_or(registry, name, {})
	summary := {
		"name": name,
		"description": dict_get_or(entry, "description", ""),
		"persistence": dict_get_or(entry, "persistence", "disk")
	}
	if name == "qdrant_http" {
		summary["collection"] := qdrant_collection_name(cfg)
		summary["sync_enabled"] := qdrant_sync_enabled(cfg)
	}
	return summary
}
