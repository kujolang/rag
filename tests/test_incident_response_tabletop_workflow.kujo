from src.common import dict_get_or, read_json_file_or
from src.tests_helpers import assert_true

kujo_bin := env_or("KUJO_BIN", "/path/to/kujo/target/debug/kujo")

suffix := to_string(current_timestamp())
valid_plan_path := "/tmp/kujo_rag_incident_plan_valid_" + suffix + ".json"
invalid_plan_path := "/tmp/kujo_rag_incident_plan_invalid_" + suffix + ".json"
workflow_doc_path := "/tmp/kujo_rag_incident_workflow_doc_" + suffix + ".md"
release_doc_path := "/tmp/kujo_rag_incident_release_doc_" + suffix + ".md"
workflow_path := "/tmp/kujo_rag_incident_workflow_" + suffix + ".yml"
report_path := "/tmp/kujo_rag_incident_report_" + suffix + ".md"
auth_runbook_path := "/tmp/kujo_rag_incident_auth_runbook_" + suffix + ".md"
data_runbook_path := "/tmp/kujo_rag_incident_data_runbook_" + suffix + ".md"
outage_runbook_path := "/tmp/kujo_rag_incident_outage_runbook_" + suffix + ".md"
quality_runbook_path := "/tmp/kujo_rag_incident_quality_runbook_" + suffix + ".md"
valid_output_path := "/tmp/kujo_rag_incident_output_valid_" + suffix + ".json"
invalid_output_path := "/tmp/kujo_rag_incident_output_invalid_" + suffix + ".json"

write_file(workflow_doc_path, "# Incident Response Tabletop Workflow\n\nIncludes follow-up issue tracking and runbook validation.\n\nRun: scripts/run_incident_response_tabletop_review.kujo\n")
write_file(release_doc_path, "# Release Process\n\nRequired gate: run scripts/run_incident_response_tabletop_review.kujo --interpreter\nSee " + workflow_doc_path + "\n")
write_file(workflow_path, "name: incident-response-tabletop-review\non:\n  schedule:\n    - cron: '0 9 * * 3'\njobs:\n  review:\n    steps:\n      - run: kujo run scripts/run_incident_response_tabletop_review.kujo --interpreter\n")
write_file(report_path, "tabletop action report")
write_file(auth_runbook_path, "auth runbook")
write_file(data_runbook_path, "data runbook")
write_file(outage_runbook_path, "service outage runbook")
write_file(quality_runbook_path, "quality regression runbook")

now := current_timestamp()

write_file(valid_plan_path, to_json({
	"version": "test-incident-v1",
	"owner": "SRE and Security",
	"last_drill_at_unix_ms": now - 1000,
	"review_cadence_days": 30,
	"scenarios": [
		{
			"id": "IR-T1",
			"incident_type": "auth_compromise",
			"runbook_path": auth_runbook_path,
			"tabletop_report_path": report_path,
			"executed_at_unix_ms": now - 1000,
			"facilitator": "On-call Lead",
			"participants": ["A", "B"],
			"lessons_learned": ["lesson"],
			"follow_up_issues": [{"id": "IR-1", "title": "t", "owner": "o", "status": "open", "target_date": "2026-06-01"}]
		},
		{
			"id": "IR-T2",
			"incident_type": "data_corruption",
			"runbook_path": data_runbook_path,
			"tabletop_report_path": report_path,
			"executed_at_unix_ms": now - 1000,
			"facilitator": "On-call Lead",
			"participants": ["A", "B"],
			"lessons_learned": ["lesson"],
			"follow_up_issues": [{"id": "IR-2", "title": "t", "owner": "o", "status": "open", "target_date": "2026-06-01"}]
		},
		{
			"id": "IR-T3",
			"incident_type": "service_outage",
			"runbook_path": outage_runbook_path,
			"tabletop_report_path": report_path,
			"executed_at_unix_ms": now - 1000,
			"facilitator": "On-call Lead",
			"participants": ["A", "B"],
			"lessons_learned": ["lesson"],
			"follow_up_issues": [{"id": "IR-3", "title": "t", "owner": "o", "status": "open", "target_date": "2026-06-01"}]
		},
		{
			"id": "IR-T4",
			"incident_type": "quality_regression",
			"runbook_path": quality_runbook_path,
			"tabletop_report_path": report_path,
			"executed_at_unix_ms": now - 1000,
			"facilitator": "On-call Lead",
			"participants": ["A", "B"],
			"lessons_learned": ["lesson"],
			"follow_up_issues": [{"id": "IR-4", "title": "t", "owner": "o", "status": "open", "target_date": "2026-06-01"}]
		}
	]
}))

write_file(invalid_plan_path, to_json({
	"version": "test-incident-v1",
	"owner": "SRE and Security",
	"last_drill_at_unix_ms": now - 1000,
	"review_cadence_days": 30,
	"scenarios": [
		{
			"id": "IR-X1",
			"incident_type": "auth_compromise",
			"runbook_path": "/tmp/missing_incident_runbook_" + suffix + ".md",
			"tabletop_report_path": "/tmp/missing_incident_report_" + suffix + ".md",
			"executed_at_unix_ms": now - 1000,
			"facilitator": "On-call Lead",
			"participants": ["A", "B"],
			"lessons_learned": ["lesson"],
			"follow_up_issues": []
		}
	]
}))

valid_cmd := "KUJO_RAG_INCIDENT_TABLETOP_PLAN_PATH=" + valid_plan_path + " KUJO_RAG_INCIDENT_TABLETOP_OUTPUT_PATH=" + valid_output_path + " KUJO_RAG_INCIDENT_TABLETOP_WORKFLOW_DOC_PATH=" + workflow_doc_path + " KUJO_RAG_RELEASE_PROCESS_DOC_PATH=" + release_doc_path + " KUJO_RAG_INCIDENT_TABLETOP_WORKFLOW_PATH=" + workflow_path + " " + kujo_bin + " run scripts/run_incident_response_tabletop_review.kujo --interpreter"
valid_res := execute_status(valid_cmd, {"timeout_ms": 240000})
assert_true(to_bool(type(valid_res) == "struct"))
assert_true(to_bool(valid_res.success == true))

valid_payload := read_json_file_or(valid_output_path, {})
assert_true(to_bool(dict_get_or(valid_payload, "ok", false) == true))
valid_gates := dict_get_or(valid_payload, "gates", {})
assert_true(to_bool(dict_get_or(valid_gates, "required_scenarios_covered", false) == true))
assert_true(to_bool(dict_get_or(valid_gates, "follow_up_tracking_present", false) == true))
assert_true(to_bool(dict_get_or(valid_gates, "workflow_defined", false) == true))

invalid_cmd := "KUJO_RAG_INCIDENT_TABLETOP_PLAN_PATH=" + invalid_plan_path + " KUJO_RAG_INCIDENT_TABLETOP_OUTPUT_PATH=" + invalid_output_path + " KUJO_RAG_INCIDENT_TABLETOP_WORKFLOW_DOC_PATH=" + workflow_doc_path + " KUJO_RAG_RELEASE_PROCESS_DOC_PATH=" + release_doc_path + " KUJO_RAG_INCIDENT_TABLETOP_WORKFLOW_PATH=" + workflow_path + " " + kujo_bin + " run scripts/run_incident_response_tabletop_review.kujo --interpreter"
invalid_res := execute_status(invalid_cmd, {"timeout_ms": 240000})
assert_true(to_bool(type(invalid_res) == "struct"))
assert_true(to_bool(invalid_res.success == false))

invalid_payload := read_json_file_or(invalid_output_path, {})
assert_true(to_bool(dict_get_or(invalid_payload, "ok", true) == false))
invalid_gates := dict_get_or(invalid_payload, "gates", {})
assert_true(to_bool(dict_get_or(invalid_gates, "required_scenarios_covered", true) == false))
assert_true(to_bool(dict_get_or(invalid_gates, "runbooks_present", true) == false))
assert_true(to_bool(dict_get_or(invalid_gates, "reports_present", true) == false))
assert_true(to_bool(dict_get_or(invalid_gates, "follow_up_tracking_present", true) == false))

if file_exists(valid_plan_path) {
	delete_file(valid_plan_path)
}
if file_exists(invalid_plan_path) {
	delete_file(invalid_plan_path)
}
if file_exists(workflow_doc_path) {
	delete_file(workflow_doc_path)
}
if file_exists(release_doc_path) {
	delete_file(release_doc_path)
}
if file_exists(workflow_path) {
	delete_file(workflow_path)
}
if file_exists(report_path) {
	delete_file(report_path)
}
if file_exists(auth_runbook_path) {
	delete_file(auth_runbook_path)
}
if file_exists(data_runbook_path) {
	delete_file(data_runbook_path)
}
if file_exists(outage_runbook_path) {
	delete_file(outage_runbook_path)
}
if file_exists(quality_runbook_path) {
	delete_file(quality_runbook_path)
}
if file_exists(valid_output_path) {
	delete_file(valid_output_path)
}
if file_exists(invalid_output_path) {
	delete_file(invalid_output_path)
}

print("test_incident_response_tabletop_workflow: ok")
