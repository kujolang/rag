from src.tests_helpers import assert_true
from src.common import dict_get_or
from src.query_api import validate_api_rbac

rbac_disabled := validate_api_rbac({"headers": {}}, {
	"api_rbac_enabled": false
}, {}, "ingest", "team_a")
assert_true(to_bool(dict_get_or(rbac_disabled, "ok", false) == true))

rbac_cfg := {
	"api_rbac_enabled": true,
	"api_rbac_default_role": "reader",
	"api_rbac_role_header": "x-kujo-role",
	"api_rbac_namespace_header": "x-kujo-namespace",
	"api_rbac_policy": {
		"admin": ["ingest", "query", "admin"],
		"writer": ["ingest", "query"],
		"reader": ["query"]
	}
}

reader_query := validate_api_rbac({
	"headers": {
		"x-kujo-role": "reader",
		"x-kujo-namespace": "team_a"
	}
}, rbac_cfg, {}, "query", "team_a")
assert_true(to_bool(dict_get_or(reader_query, "ok", false) == true))

reader_ingest := validate_api_rbac({
	"headers": {
		"x-kujo-role": "reader",
		"x-kujo-namespace": "team_a"
	}
}, rbac_cfg, {}, "ingest", "team_a")
assert_true(to_bool(dict_get_or(reader_ingest, "ok", true) == false))
assert_true(to_bool(dict_get_or(reader_ingest, "error", "") == "rbac_forbidden"))

writer_wrong_namespace := validate_api_rbac({
	"headers": {
		"x-kujo-role": "writer",
		"x-kujo-namespace": "team_b"
	}
}, rbac_cfg, {}, "ingest", "team_a")
assert_true(to_bool(dict_get_or(writer_wrong_namespace, "ok", true) == false))
assert_true(to_bool(dict_get_or(writer_wrong_namespace, "error", "") == "rbac_namespace_forbidden"))

jwt_context_allowed := validate_api_rbac({"headers": {}}, rbac_cfg, {
	"role": "writer",
	"namespace_scope": "team_a"
}, "ingest", "team_a")
assert_true(to_bool(dict_get_or(jwt_context_allowed, "ok", false) == true))

jwt_context_denied := validate_api_rbac({"headers": {}}, rbac_cfg, {
	"role": "writer",
	"namespace_scope": "team_a"
}, "ingest", "team_b")
assert_true(to_bool(dict_get_or(jwt_context_denied, "ok", true) == false))
assert_true(to_bool(dict_get_or(jwt_context_denied, "error", "") == "rbac_namespace_forbidden"))

admin_global := validate_api_rbac({
	"headers": {
		"x-kujo-role": "admin",
		"x-kujo-namespace": "*"
	}
}, rbac_cfg, {}, "admin", "team_x")
assert_true(to_bool(dict_get_or(admin_global, "ok", false) == true))

print("test_rbac_authorization: ok")