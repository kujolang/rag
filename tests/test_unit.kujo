# Reranking tests (RAG-002)
rerank_index := {
	"chunks": [
		{"chunk_id": "r1", "doc_id": "rd1", "path": "docs/r1.md", "text": "kujo ranking", "line_start": 1, "line_end": 1, "meta": {"kind": "markdown"}},
		{"chunk_id": "r2", "doc_id": "rd2", "path": "docs/r2.md", "text": "kujo ranking", "line_start": 1, "line_end": 1, "meta": {"kind": "markdown"}},
		{"chunk_id": "r3", "doc_id": "rd3", "path": "docs/r3.md", "text": "kujo ranking", "line_start": 1, "line_end": 1, "meta": {"kind": "markdown"}}
	],
	"vectors": [
		{"chunk_id": "r1", "embedding": [1.0, 0.0, 0.0]},
		{"chunk_id": "r2", "embedding": [0.99, 0.01, 0.0]},
		{"chunk_id": "r3", "embedding": [0.0, 1.0, 0.0]}
	],
	"lexical": [
		{"chunk_id": "r1", "term_freq": {"kujo": 10}, "term_count": 10},
		{"chunk_id": "r2", "term_freq": {"kujo": 9}, "term_count": 9},
		{"chunk_id": "r3", "term_freq": {"kujo": 8}, "term_count": 8}
	]
}

rerank_none := hybrid_search(rerank_index, "kujo", {
	"embedding_provider": "hash",
	"embedding_dims": 16,
	"top_k": 2,
	"hybrid_alpha": 0.0,
	"hybrid_beta": 1.0,
	"query_expansion": false,
	"rerank_strategy": "none"
})
assert_true(to_bool(len(rerank_none) == 2))
assert_true(to_bool(dict_get_or(rerank_none[0], "chunk_id", "") != ""))
assert_true(to_bool(dict_get_or(rerank_none[1], "chunk_id", "") != ""))

rerank_mmr := hybrid_search(rerank_index, "kujo", {
	"embedding_provider": "hash",
	"embedding_dims": 16,
	"top_k": 2,
	"hybrid_alpha": 0.0,
	"hybrid_beta": 1.0,
	"query_expansion": false,
	"rerank_strategy": "mmr",
	"rerank_mmr_lambda": 0.35
})
assert_true(to_bool(len(rerank_mmr) == 2))

rerank_mmr_repeat := hybrid_search(rerank_index, "kujo", {
	"embedding_provider": "hash",
	"embedding_dims": 16,
	"top_k": 2,
	"hybrid_alpha": 0.0,
	"hybrid_beta": 1.0,
	"query_expansion": false,
	"rerank_strategy": "mmr",
	"rerank_mmr_lambda": 0.35
})
assert_true(to_bool(len(rerank_mmr_repeat) == 2))
assert_true(to_bool(dict_get_or(rerank_mmr[0], "chunk_id", "") == dict_get_or(rerank_mmr_repeat[0], "chunk_id", "")))
assert_true(to_bool(dict_get_or(rerank_mmr[1], "chunk_id", "") == dict_get_or(rerank_mmr_repeat[1], "chunk_id", "")))

# CLI parsing tests
parsed_cli := parse_cli(["ingest", "--path", "./examples/kujo_docs/example.kujo", "--recursive", "true"])
parsed_flags := dict_get_or(parsed_cli, "flags", {})
assert_true(to_bool(dict_get_or(parsed_flags, "path", "") == "./examples/kujo_docs/example.kujo"))

valid_port := parse_int_flag({"port": "8787"}, "port", 3000)
assert_true(to_bool(dict_get_or(valid_port, "ok", false) == true))
assert_true(to_bool(dict_get_or(valid_port, "value", 0) == 8787))

invalid_port := parse_int_flag({"port": "abc"}, "port", 3000)
assert_true(to_bool(dict_get_or(invalid_port, "ok", true) == false))
assert_true(to_bool(dict_get_or(invalid_port, "error", "") == "invalid_int_flag"))

# Namespace isolation config tests (PRD-001)
namespace_base_cfg := load_config({
	"index_path": "./data/rag_index.json"
})

namespace_default := cfg_with_namespace(namespace_base_cfg, "")
assert_true(to_bool(dict_get_or(namespace_default, "ok", false) == true))
assert_true(to_bool(dict_get_or(namespace_default, "namespace", "") == "default"))

namespace_team := cfg_with_namespace(namespace_base_cfg, "Team_A")
assert_true(to_bool(dict_get_or(namespace_team, "ok", false) == true))
assert_true(to_bool(dict_get_or(namespace_team, "namespace", "") == "team_a"))
team_cfg := dict_get_or(namespace_team, "cfg", {})
assert_true(to_bool(contains(dict_get_or(team_cfg, "index_path", ""), "__team_a.json") == 1))

namespace_invalid := cfg_with_namespace(namespace_base_cfg, "../../secrets")
assert_true(to_bool(dict_get_or(namespace_invalid, "ok", true) == false))
assert_true(to_bool(dict_get_or(namespace_invalid, "error", "") == "invalid_namespace"))

# Vector backend adapter tests (PRD-002)
backend_registry := get_vector_backend_registry()
assert_true(to_bool(has_key(backend_registry, "local_json") == 1))
assert_true(to_bool(has_key(backend_registry, "memory") == 1))

backend_invalid_cfg := load_config({
	"vector_backend": "unknown-backend"
})
assert_true(to_bool(dict_get_or(backend_invalid_cfg, "vector_backend", "") == "local_json"))

memory_backend_cfg_a := load_config({
	"vector_backend": "memory",
	"vector_backend_memory_key": "unit-memory-a-" + to_string(current_timestamp())
})
memory_index_a := load_index_with_backend(memory_backend_cfg_a)
memory_meta_a := dict_get_or(memory_index_a, "meta", {})
memory_meta_a["documents"] := 3
memory_index_a["meta"] := memory_meta_a
_ = save_index_with_backend(memory_backend_cfg_a, memory_index_a)

memory_index_a_reload := load_index_with_backend(memory_backend_cfg_a)
assert_true(to_bool(dict_get_or(dict_get_or(memory_index_a_reload, "meta", {}), "documents", 0) == 3))

memory_backend_cfg_b := load_config({
	"vector_backend": "memory",
	"vector_backend_memory_key": "unit-memory-b-" + to_string(current_timestamp())
})
memory_index_b := load_index_with_backend(memory_backend_cfg_b)
assert_true(to_bool(dict_get_or(dict_get_or(memory_index_b, "meta", {}), "documents", 0) != 3))

# Chunking smoke test
docs := [{
	"doc_id": "doc1",
	"path": "memory://doc1",
	"kind": "text",
	"content": "line one\nline two\nline three",
	"lines": [
		{"line": 1, "text": "line one"},
		{"line": 2, "text": "line two"},
		{"line": 3, "text": "line three"}
	],
	"meta": {}
}]

chunks := chunk_documents(docs, {
	"chunk_strategy": "line",
	"chunk_size": 20,
	"chunk_overlap": 5
})

assert_true(to_bool(len(chunks) >= 1))
assert_true(to_bool(has_key(chunks[0], "chunk_id") == 1))

line_overlap_chunks := chunk_document(docs[0], {
	"chunk_strategy": "line",
	"chunk_size": 7,
	"chunk_overlap": 3
})
assert_true(to_bool(len(line_overlap_chunks) >= 2))
for item in line_overlap_chunks {
	assert_true(to_bool(dict_get_or(item, "line_end", 0) >= dict_get_or(item, "line_start", 0)))
}

fixed_doc := {
	"doc_id": "doc_fixed",
	"path": "memory://fixed",
	"kind": "text",
	"content": "alpha line\nbeta line\ngamma line",
	"lines": [
		{"line": 1, "text": "alpha line"},
		{"line": 2, "text": "beta line"},
		{"line": 3, "text": "gamma line"}
	],
	"meta": {}
}

fixed_chunks := chunk_document(fixed_doc, {
	"chunk_strategy": "fixed",
	"chunk_size": 8,
	"chunk_overlap": 2
})
assert_true(to_bool(len(fixed_chunks) >= 2))
fixed_total_lines := len(dict_get_or(fixed_doc, "lines", []))
all_coarse := true
for item in fixed_chunks {
	line_start := dict_get_or(item, "line_start", 0)
	line_end := dict_get_or(item, "line_end", 0)
	assert_true(to_bool(line_end >= line_start))
	if line_start != 1 || line_end != fixed_total_lines {
		all_coarse = false
	}
}
assert_true(to_bool(all_coarse == false))

preset_doc := {
	"doc_id": "doc_preset_json",
	"path": "memory://structured/records.json",
	"kind": "structured",
	"content": "schema: records | format: json | fields: service, incident_code, summary\nrow 1 | service: gateway | incident_code: inc_a1 | summary: normal_traffic_profile\nrow 2 | service: auth | incident_code: inc_a2 | summary: token_refresh_latency\nrow 3 | service: inventory | incident_code: inc_a3 | summary: cache_miss_spike\nrow 4 | service: orders | incident_code: inc_a4 | summary: replication_lag_warning\nrow 5 | service: billing | incident_code: inc_a5 | summary: retry_queue_growth\nrow 6 | service: search | incident_code: inc_a6 | summary: ranking_index_warmup\nrow 7 | service: reports | incident_code: inc_a7 | summary: warehouse_backfill_delay\nrow 8 | service: payments | incident_code: inc_a8 | summary: critical_orchid_outage",
	"lines": [
		{"line": 1, "text": "schema: records | format: json | fields: service, incident_code, summary"},
		{"line": 2, "text": "row 1 | service: gateway | incident_code: inc_a1 | summary: normal_traffic_profile"},
		{"line": 3, "text": "row 2 | service: auth | incident_code: inc_a2 | summary: token_refresh_latency"},
		{"line": 4, "text": "row 3 | service: inventory | incident_code: inc_a3 | summary: cache_miss_spike"},
		{"line": 5, "text": "row 4 | service: orders | incident_code: inc_a4 | summary: replication_lag_warning"},
		{"line": 6, "text": "row 5 | service: billing | incident_code: inc_a5 | summary: retry_queue_growth"},
		{"line": 7, "text": "row 6 | service: search | incident_code: inc_a6 | summary: ranking_index_warmup"},
		{"line": 8, "text": "row 7 | service: reports | incident_code: inc_a7 | summary: warehouse_backfill_delay"},
		{"line": 9, "text": "row 8 | service: payments | incident_code: inc_a8 | summary: critical_orchid_outage"}
	],
	"meta": {
		"parser": "structured_json"
	}
}

preset_cfg := {
	"chunk_strategy": "line",
	"chunk_size": 900,
	"chunk_overlap": 150,
	"chunk_presets_enabled": true,
	"chunk_presets": {
		"json": {
			"chunk_strategy": "fixed",
			"chunk_size": 220,
			"chunk_overlap": 40
		}
	}
}

baseline_cfg := {
	"chunk_strategy": "line",
	"chunk_size": 900,
	"chunk_overlap": 150,
	"chunk_presets_enabled": false,
	"chunk_presets": {
		"json": {
			"chunk_strategy": "fixed",
			"chunk_size": 220,
			"chunk_overlap": 40
		}
	}
}

baseline_chunks := chunk_document(preset_doc, baseline_cfg)
preset_chunks := chunk_document(preset_doc, preset_cfg)
assert_true(to_bool(len(baseline_chunks) == 1))
assert_true(to_bool(len(preset_chunks) > 1))
assert_true(to_bool(dict_get_or(dict_get_or(baseline_chunks[0], "meta", {}), "chunk_profile_source", "") == "baseline"))
assert_true(to_bool(dict_get_or(dict_get_or(preset_chunks[0], "meta", {}), "chunk_profile_source", "") == "preset:json"))
assert_true(to_bool(dict_get_or(dict_get_or(preset_chunks[0], "meta", {}), "chunk_profile_strategy", "") == "fixed"))

override_doc := {
	"doc_id": dict_get_or(preset_doc, "doc_id", ""),
	"path": dict_get_or(preset_doc, "path", ""),
	"kind": dict_get_or(preset_doc, "kind", "structured"),
	"content": dict_get_or(preset_doc, "content", ""),
	"lines": dict_get_or(preset_doc, "lines", []),
	"meta": {
		"parser": "structured_json",
		"chunking_override": {
			"chunk_strategy": "line",
			"chunk_size": 260,
			"chunk_overlap": 50
		}
	}
}

override_chunks := chunk_document(override_doc, preset_cfg)
assert_true(to_bool(len(override_chunks) > 1))
assert_true(to_bool(dict_get_or(dict_get_or(override_chunks[0], "meta", {}), "chunk_profile_source", "") == "doc_override"))
assert_true(to_bool(dict_get_or(dict_get_or(override_chunks[0], "meta", {}), "chunk_profile_strategy", "") == "line"))

# Registry tests (parsers + embeddings)
parser_registry := get_parser_registry()
assert_true(to_bool(dict_get_or(parser_registry, "md", "") == "markdown"))
assert_true(to_bool(dict_get_or(parser_registry, "mdx", "") == "markdown"))
assert_true(to_bool(dict_get_or(parser_registry, "pdf", "") == "pdf"))

embedding_registry := get_embedding_provider_registry()
assert_true(to_bool(dict_get_or(embedding_registry, "openai", "") == "ai"))
assert_true(to_bool(dict_get_or(embedding_registry, "hash", "") == "hash"))

unknown_provider_result := embed_texts(["registry test"], {
	"embedding_provider": "mystery",
	"embedding_dims": 32
})
assert_true(to_bool(dict_get_or(unknown_provider_result, "provider", "") == "hash"))
assert_true(to_bool(dict_get_or(dict_get_or(unknown_provider_result, "error", {}), "code", "") == "unknown_embedding_provider"))

ai_fallback_result := embed_texts(["fallback test"], {
	"embedding_provider": "ai",
	"embedding_dims": 32,
	"ai_embed_endpoint": "",
	"ai_embed_model": ""
})
assert_true(to_bool(dict_get_or(ai_fallback_result, "provider", "") == "hash"))
assert_true(to_bool(dict_get_or(dict_get_or(ai_fallback_result, "error", {}), "code", "") == "ai_provider_not_configured"))

