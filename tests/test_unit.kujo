mdx_doc := parse_file(mdx_test_path, {})
assert_true(to_bool(dict_get_or(mdx_doc, "kind", "") == "markdown"))
assert_true(to_bool(dict_get_or(dict_get_or(mdx_doc, "meta", {}), "parser", "") == "markdown"))
if file_exists(mdx_test_path) {
	delete_file(mdx_test_path)
}

