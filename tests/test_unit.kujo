	"top_k": 6,
	"hybrid_alpha": 0.65,
	"hybrid_beta": 0.35,
	"query_expansion": false,
	"query_filters": {
		"extension": ".txt"
	}
})
assert_true(to_bool(len(ext_results) == 1))
assert_true(to_bool(dict_get_or(ext_results[0], "path", "") == "docs/api.txt"))

