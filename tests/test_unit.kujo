from src.common import tokenize, term_frequency, cosine_similarity, dict_get_or, rank_desc
from src.chunking import chunk_document, chunk_documents
from src.parsers import parse_file, get_parser_registry
from src.embeddings import embed_texts, get_embedding_provider_registry
from src.query_api import validate_api_ingest_path, validate_api_auth, parse_api_json_body, get_session_history, append_session_turn, create_ingest_job, set_ingest_job_status, get_ingest_job, resolve_cors_origin, prune_rate_state
from src.vector_store import load_index
from src.vector_backend import get_vector_backend_registry, load_index_with_backend, save_index_with_backend
from src.cli_args import parse_cli, parse_int_flag
from src.retrieval import hybrid_search
from src.tests_helpers import assert_true
from src.config import load_config, cfg_with_namespace

func array_has_value(items, value) {
	for item in items {
		if to_string(item) == to_string(value) {
			return true
		}
	}
	return false
}

sample := "Kujo language kujo LANGUAGE"
tokens := tokenize(sample)
assert_true(to_bool(len(tokens) >= 3))

freq := term_frequency(tokens)
assert_true(to_bool(has_key(freq, "kujo") == 1))
assert_true(to_bool(freq["kujo"] >= 2))

sim_same := cosine_similarity([1.0, 0.0], [1.0, 0.0])
assert_true(to_bool(sim_same > 0.99))

sim_diff := cosine_similarity([1.0, 0.0], [0.0, 1.0])
assert_true(to_bool(sim_diff < 0.01))

rank_input := [
	{"id": "a", "score": 10.0},
	{"id": "b", "score": 10.0},
	{"id": "c", "score": 8.0}
]
rank_output := rank_desc(rank_input, "score", 2)
assert_true(to_bool(len(rank_output) == 2))
assert_true(to_bool(dict_get_or(rank_output[0], "id", "") == "a"))
assert_true(to_bool(dict_get_or(rank_output[1], "id", "") == "b"))

# Retrieval filter tests (RAG-001)
filter_index := {
	"chunks": [
		{
			"chunk_id": "c1",
			"doc_id": "d1",
			"path": "docs/guide.md",
			"text": "Kujo imports guide",
			"line_start": 1,
			"line_end": 2,
			"meta": {
				"kind": "markdown",
				"tags": ["guide", "docs"],
				"author": "alice",
				"timestamp": "2026-05-25T09:30:00Z",
				"source_system": "notion",
				"sensitivity_tags": ["internal", "confidential"]
			}
		},
		{
			"chunk_id": "c2",
			"doc_id": "d2",
			"path": "docs/api.txt",
			"text": "Kujo API query usage",
			"line_start": 1,
			"line_end": 2,
			"meta": {
				"kind": "text",
				"tags": ["api", "docs"],
				"author": "bob",
				"timestamp": "2026-05-24",
				"source_system": "github",
				"sensitivity_tags": ["public"]
			}
		},
		{
			"chunk_id": "c3",
			"doc_id": "d3",
			"path": "notes/changelog.md",
			"text": "Release notes and fixes",
			"line_start": 1,
			"line_end": 2,
			"meta": {
				"kind": "markdown",
				"tags": ["release"],
				"author": "ops",
				"timestamp": "2025-12-01",
				"source_system": "jira",
				"sensitivity_tags": ["internal"]
			}
		}
	],
	"vectors": [
		{"chunk_id": "c1", "embedding": [1.0, 0.0, 0.0]},
		{"chunk_id": "c2", "embedding": [0.9, 0.1, 0.0]},
		{"chunk_id": "c3", "embedding": [0.1, 0.9, 0.0]}
	],
	"lexical": [
		{"chunk_id": "c1", "term_freq": {"kujo": 2, "imports": 1}, "term_count": 3},
		{"chunk_id": "c2", "term_freq": {"kujo": 1, "api": 2, "query": 1}, "term_count": 4},
		{"chunk_id": "c3", "term_freq": {"release": 2, "notes": 1}, "term_count": 3}
	]
}

filter_cfg := {
	"embedding_provider": "hash",
	"embedding_dims": 16,
	"top_k": 6,
	"hybrid_alpha": 0.65,
	"hybrid_beta": 0.35,
	"query_expansion": false
}

all_results := hybrid_search(filter_index, "kujo query", filter_cfg)
assert_true(to_bool(len(all_results) == 3))
for item in all_results {
	confidence := dict_get_or(item, "confidence", -1.0)
	assert_true(to_bool(confidence >= 0.0))
	assert_true(to_bool(confidence <= 1.0))
	assert_true(to_bool(has_key(item, "provenance_score") == 1))
	assert_true(to_bool(has_key(item, "confidence_band") == 1))
}

all_results_repeat := hybrid_search(filter_index, "kujo query", filter_cfg)
assert_true(to_bool(len(all_results_repeat) == 3))
assert_true(to_bool(dict_get_or(all_results[0], "confidence", 0.0) == dict_get_or(all_results_repeat[0], "confidence", -1.0)))

path_results := hybrid_search(filter_index, "kujo query", {
	"embedding_provider": "hash",
	"embedding_dims": 16,
	"top_k": 6,
	"hybrid_alpha": 0.65,
	"hybrid_beta": 0.35,
	"query_expansion": false,
	"query_filters": {
		"path": "docs/"
	}
})
assert_true(to_bool(len(path_results) == 2))
for item in path_results {
	assert_true(to_bool(contains(dict_get_or(item, "path", ""), "docs/") == 1))
}

