	delete_file(metadata_test_path)
}
write_file(metadata_test_path, "Author: Dana Ops\nUpdated_At: 2026-05-25T10:00:00Z\nSource_System: jira\nSensitivity: internal, confidential\n\nrunbook body")
metadata_doc := parse_file(metadata_test_path, {})
metadata_meta := dict_get_or(metadata_doc, "meta", {})
assert_true(to_bool(dict_get_or(metadata_meta, "author", "") == "Dana Ops"))
assert_true(to_bool(dict_get_or(metadata_meta, "timestamp", "") == "2026-05-25T10:00:00Z"))
assert_true(to_bool(dict_get_or(metadata_meta, "source_system", "") == "jira"))
metadata_sensitivity := dict_get_or(metadata_meta, "sensitivity_tags", [])
assert_true(to_bool(array_has_value(metadata_sensitivity, "internal")))
assert_true(to_bool(array_has_value(metadata_sensitivity, "confidential")))
assert_true(to_bool(array_has_value(dict_get_or(metadata_meta, "tags", []), "source_jira")))
if file_exists(metadata_test_path) {
	delete_file(metadata_test_path)
}

# Index schema migration tests
if path_exists("results") == false {
	create_dir("results")
}

v1_index_path := "results/test_index_v1.json"
if file_exists(v1_index_path) {
	delete_file(v1_index_path)
}
write_file(v1_index_path, to_json({
	"version": "1.0",
	"created_at": 1,
	"updated_at": 1,
	"chunks": [],
	"vectors": [],
	"lexical": [],
	"meta": {
		"documents": 0,
		"chunks": 0,
		"provider": "hash"
	}
}))

migrated_v1 := load_index(v1_index_path)
assert_true(to_bool(dict_get_or(migrated_v1, "schema_version", 0) == 2))
assert_true(to_bool(dict_get_or(dict_get_or(migrated_v1, "meta", {}), "migrated_from_schema_version", 0) == 1))

unsupported_index_path := "results/test_index_unsupported.json"
if file_exists(unsupported_index_path) {
	delete_file(unsupported_index_path)
}
write_file(unsupported_index_path, to_json({
	"schema_version": 99,
	"version": "99.0",
	"chunks": [],
	"vectors": [],
	"lexical": [],
	"meta": {}
}))

unsupported_index := load_index(unsupported_index_path)
assert_true(to_bool(dict_get_or(dict_get_or(dict_get_or(unsupported_index, "meta", {}), "load_error", {}), "code", "") == "unsupported_index_schema"))
assert_true(to_bool(dict_get_or(unsupported_index, "schema_version", 0) == 2))

if file_exists(v1_index_path) {
	delete_file(v1_index_path)
}

if file_exists(unsupported_index_path) {
	delete_file(unsupported_index_path)
}

# API ingest path scope enforcement tests
scope_cfg := {
	"project_root": "/workspace/repo",
	"api_ingest_allowed_roots": ["./examples", "/workspace/repo/docs"]
}

allowed_path := validate_api_ingest_path("./examples/kujo_docs", scope_cfg)
assert_true(to_bool(dict_get_or(allowed_path, "ok", false) == true))
assert_true(to_bool(dict_get_or(allowed_path, "path", "") == "/workspace/repo/examples/kujo_docs"))

normalized_allowed := validate_api_ingest_path("./examples/../examples/kujo_docs", scope_cfg)
assert_true(to_bool(dict_get_or(normalized_allowed, "ok", false) == true))

blocked_path := validate_api_ingest_path("../secrets", scope_cfg)
assert_true(to_bool(dict_get_or(blocked_path, "ok", true) == false))
assert_true(to_bool(dict_get_or(blocked_path, "error", "") == "ingest_path_forbidden"))

# API auth tests (disabled/enabled modes)
auth_disabled := validate_api_auth({"headers": {}}, {"api_bearer_token": ""})
assert_true(to_bool(dict_get_or(auth_disabled, "ok", false) == true))

auth_missing := validate_api_auth({"headers": {}}, {"api_bearer_token": "sec-token"})
assert_true(to_bool(dict_get_or(auth_missing, "ok", true) == false))
assert_true(to_bool(dict_get_or(auth_missing, "status", 0) == 401))
assert_true(to_bool(dict_get_or(auth_missing, "error", "") == "unauthorized"))

auth_invalid_header := validate_api_auth({"headers": {"Authorization": "Basic abc"}}, {"api_bearer_token": "sec-token"})
assert_true(to_bool(dict_get_or(auth_invalid_header, "ok", true) == false))
assert_true(to_bool(dict_get_or(auth_invalid_header, "status", 0) == 401))
assert_true(to_bool(dict_get_or(auth_invalid_header, "error", "") == "invalid_auth_header"))

auth_bad_token := validate_api_auth({"headers": {"authorization": "Bearer wrong-token"}}, {"api_bearer_token": "sec-token"})
assert_true(to_bool(dict_get_or(auth_bad_token, "ok", true) == false))
assert_true(to_bool(dict_get_or(auth_bad_token, "status", 0) == 403))
assert_true(to_bool(dict_get_or(auth_bad_token, "error", "") == "forbidden"))

auth_good_token := validate_api_auth({"headers": {"authorization": "Bearer sec-token"}}, {"api_bearer_token": "sec-token"})
assert_true(to_bool(dict_get_or(auth_good_token, "ok", false) == true))

# Session mode tests (RAG-003)
session_state := {
	"sessions": {}
}
session_cfg := {
	"session_history_max_turns": 2
}

session_state = append_session_turn(session_state, "alpha", {
	"query": "q1",
	"answer": "a1"
}, session_cfg)
session_state = append_session_turn(session_state, "alpha", {
	"query": "q2",
	"answer": "a2"
}, session_cfg)
session_state = append_session_turn(session_state, "alpha", {
	"query": "q3",
	"answer": "a3"
}, session_cfg)

alpha_history := get_session_history(session_state, "alpha", session_cfg)
assert_true(to_bool(len(alpha_history) == 2))
assert_true(to_bool(dict_get_or(alpha_history[0], "query", "") == "q2"))
assert_true(to_bool(dict_get_or(alpha_history[1], "query", "") == "q3"))

session_state = append_session_turn(session_state, "beta", {
	"query": "other",
	"answer": "thread"
}, session_cfg)
beta_history := get_session_history(session_state, "beta", session_cfg)
assert_true(to_bool(len(beta_history) == 1))
assert_true(to_bool(dict_get_or(beta_history[0], "query", "") == "other"))
alpha_history_after := get_session_history(session_state, "alpha", session_cfg)
assert_true(to_bool(len(alpha_history_after) == 2))

# Ingest job lifecycle tests (API-001)
job_state := {
	"ingest_jobs": {}
}
job_create := create_ingest_job(job_state, "./examples/kujo_docs", true, "default")
job_state = dict_get_or(job_create, "state", job_state)
job := dict_get_or(job_create, "job", {})
job_id := dict_get_or(job, "job_id", "")
assert_true(to_bool(job_id != ""))
assert_true(to_bool(dict_get_or(job, "status", "") == "submitted"))

job_state = set_ingest_job_status(job_state, job_id, "running", {
	"started_at": current_timestamp()
})
running_job := get_ingest_job(job_state, job_id)
assert_true(to_bool(dict_get_or(running_job, "status", "") == "running"))

job_state = set_ingest_job_status(job_state, job_id, "succeeded", {
	"summary": {
		"documents": 3,
		"chunks": 12
	}
})
succeeded_job := get_ingest_job(job_state, job_id)
assert_true(to_bool(dict_get_or(succeeded_job, "status", "") == "succeeded"))
assert_true(to_bool(dict_get_or(dict_get_or(succeeded_job, "result", {}), "summary", {})["documents"] == 3))

missing_job := get_ingest_job(job_state, "does-not-exist")
assert_true(to_bool(type(missing_job) == "null"))

# CORS allow-list tests (API-002)
cors_req_allowed := {
	"headers": {
		"Origin": "https://allowed.example"
	}
}
cors_cfg_disabled := {
	"api_cors_enabled": false,
	"api_cors_allowed_origins": ["https://allowed.example"]
}
assert_true(to_bool(resolve_cors_origin(cors_req_allowed, cors_cfg_disabled) == ""))

cors_cfg_enabled := {
	"api_cors_enabled": true,
	"api_cors_allowed_origins": ["https://allowed.example", "https://other.example"]
}
assert_true(to_bool(resolve_cors_origin(cors_req_allowed, cors_cfg_enabled) == "https://allowed.example"))

cors_req_blocked := {
	"headers": {
		"Origin": "https://blocked.example"
	}
}
assert_true(to_bool(resolve_cors_origin(cors_req_blocked, cors_cfg_enabled) == ""))

cors_cfg_wildcard := {
	"api_cors_enabled": true,
	"api_cors_allowed_origins": ["*"]
}
assert_true(to_bool(resolve_cors_origin(cors_req_allowed, cors_cfg_wildcard) == "*"))

# Rate limiter eviction tests (API-003)
rate_state := {
	"rate": {
		"stale": {"window_start": 1000, "count": 1},
		"fresh": {"window_start": 90000, "count": 1}
	}
}
rate_cfg := {
	"api_rate_limit_window_sec": 60,
	"api_rate_limit_bucket_ttl_sec": 30,
	"api_rate_limit_max_keys": 10
}
rate_state = prune_rate_state(rate_state, rate_cfg, 100000)
assert_true(to_bool(has_key(dict_get_or(rate_state, "rate", {}), "stale") == 0))
assert_true(to_bool(has_key(dict_get_or(rate_state, "rate", {}), "fresh") == 1))

cap_state := {
	"rate": {
		"k1": {"window_start": 1000, "count": 1},
		"k2": {"window_start": 2000, "count": 1},
		"k3": {"window_start": 3000, "count": 1}
	}
}
cap_cfg := {
	"api_rate_limit_window_sec": 60,
	"api_rate_limit_bucket_ttl_sec": 9999,
	"api_rate_limit_max_keys": 2
}
cap_state = prune_rate_state(cap_state, cap_cfg, 4000)
cap_rate := dict_get_or(cap_state, "rate", {})
assert_true(to_bool(len(keys(cap_rate)) == 2))
assert_true(to_bool(has_key(cap_rate, "k1") == 0))
assert_true(to_bool(has_key(cap_rate, "k2") == 1))
assert_true(to_bool(has_key(cap_rate, "k3") == 1))

invalid_body_dict := parse_api_json_body({"body": {}}, {"api_max_body_bytes": 100})
assert_true(to_bool(dict_get_or(invalid_body_dict, "ok", true) == false))
assert_true(to_bool(dict_get_or(invalid_body_dict, "error", "") == "invalid_body_type"))
assert_true(to_bool(dict_get_or(dict_get_or(invalid_body_dict, "details", {}), "actual_type", "") == "dict"))

invalid_body_int := parse_api_json_body({"body": 42}, {"api_max_body_bytes": 100})
assert_true(to_bool(dict_get_or(invalid_body_int, "ok", true) == false))
assert_true(to_bool(dict_get_or(invalid_body_int, "error", "") == "invalid_body_type"))

body_too_large := parse_api_json_body({
	"body": "{\"query\":\"12345678901234567890\"}"
}, {
	"api_max_body_bytes": 10
})
assert_true(to_bool(dict_get_or(body_too_large, "ok", true) == false))
assert_true(to_bool(dict_get_or(body_too_large, "error", "") == "body_too_large"))

# PDF parser behavior tests (shell success and fallback)
if path_exists("results") == false {
	create_dir("results")
}
if file_exists("results/test.pdf") {
	delete_file("results/test.pdf")
}
write_file("results/test.pdf", "fake")

pdf_cfg_ok := {
	"pdf_extractor_command": "echo"
}
pdf_doc_ok := parse_file("results/test.pdf", pdf_cfg_ok)
assert_true(to_bool(dict_get_or(dict_get_or(pdf_doc_ok, "meta", {}), "parser", "") == "pdf_shell"))

pdf_cfg_fail := {
	"pdf_extractor_command": "definitely_missing_pdf_binary"
}
pdf_doc_fail := parse_file("results/missing.pdf", pdf_cfg_fail)
assert_true(to_bool(dict_get_or(dict_get_or(pdf_doc_fail, "meta", {}), "parser", "") == "pdf_fallback"))
assert_true(to_bool(dict_get_or(dict_get_or(pdf_doc_fail, "meta", {}), "error_code", "") == "pdf_extract_failed"))

extractor_payload_file := "results/sec001_extractor_payload.txt"
if file_exists(extractor_payload_file) {
	delete_file(extractor_payload_file)
}
pdf_cfg_injection := {
	"pdf_extractor_command": "echo;touch results/sec001_extractor_payload.txt"
}
pdf_doc_injection := parse_file("results/test.pdf", pdf_cfg_injection)
assert_true(to_bool(dict_get_or(dict_get_or(pdf_doc_injection, "meta", {}), "parser", "") == "pdf_fallback"))
assert_true(to_bool(dict_get_or(dict_get_or(pdf_doc_injection, "meta", {}), "error_code", "") == "invalid_pdf_extractor"))
assert_true(to_bool(file_exists(extractor_payload_file) == false))

path_payload_file := "sec001_path_payload.txt"
if file_exists(path_payload_file) {
	delete_file(path_payload_file)
}
path_injection_pdf := "results/test\";touch sec001_path_payload.txt;\".pdf"
write_file(path_injection_pdf, "fake")
pdf_doc_path_payload := parse_file(path_injection_pdf, pdf_cfg_ok)
assert_true(to_bool(dict_get_or(dict_get_or(pdf_doc_path_payload, "meta", {}), "parser", "") == "pdf_shell"))
assert_true(to_bool(file_exists(path_payload_file) == false))

if file_exists(path_injection_pdf) {
	delete_file(path_injection_pdf)
}

if file_exists(extractor_payload_file) {
	delete_file(extractor_payload_file)
}

if file_exists(path_payload_file) {
	delete_file(path_payload_file)
}

if file_exists("results/test.pdf") {
	delete_file("results/test.pdf")
}

print("test_unit: ok")
