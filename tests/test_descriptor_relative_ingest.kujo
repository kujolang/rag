from src.common import dict_get_or, filesystem_capability_scope
from src.ingestion import ingest_documents
from src.parsers import parse_file
from src.tests_helpers import assert_true

suffix := to_string(current_timestamp())
root := "results/descriptor_ingest_" + suffix
create_dir(root)
sample := root + "/sample.txt"
write_file(sample, "portable descriptor-relative ingest")

scope := filesystem_capability_scope(sample)
capability_root := dict_get_or(scope, "root", "")
capability_relative := dict_get_or(scope, "relative", "")
assert_true(to_bool(capability_root != ""))
assert_true(to_bool(capability_relative != ""))
assert_true(to_bool(path_exists(capability_root)))
assert_true(to_bool(contains(capability_relative, "descriptor_ingest_")))

raw_absolute := path_absolute(sample)
normalized_absolute := regex_replace(raw_absolute, "\\\\", "/")
if starts_with(normalized_absolute, "//?/") {
	# Windows canonical paths use verbatim roots. The capability root must keep
	# native separators instead of passing a corrupted //?/C:/ root to Rust.
	assert_true(to_bool(contains(capability_root, "\\")))
}

result := ingest_documents(root, {
	"ingest_extensions": ["txt"],
	"max_file_bytes": 5000000,
	"parser_sandbox_max_bytes": 10000000
}, true)
assert_true(to_bool(dict_get_or(dict_get_or(result, "stats", {}), "docs_loaded", 0) == 1))
assert_true(to_bool(len(dict_get_or(result, "errors", [])) == 0))

# Parent-relative paths retain their meaning instead of being silently
# rebound beneath the current directory.
parent_root := root + "/parent"
child_root := parent_root + "/child"
create_dir(parent_root)
create_dir(child_root)
write_file(parent_root + "/parent-note.txt", "parent relative source")
original_cwd := os_getcwd()
_ = os_chdir(child_root)
parent_doc := parse_file("../parent-note.txt", {
	"parser_sandbox_max_bytes": 5000000
})
_ = os_chdir(original_cwd)
assert_true(to_bool(contains(dict_get_or(parent_doc, "content", ""), "parent relative source")))

# Backslashes are ordinary filename characters on Unix, and // is a valid
# POSIX spelling of an absolute path. Neither may be interpreted as Windows
# syntax on a Unix runtime.
cwd_absolute := path_absolute(".")
if starts_with(cwd_absolute, "/") {
	backslash_path := root + "/back\\slash.txt"
	write_file(backslash_path, "unix backslash filename")
	backslash_doc := parse_file(backslash_path, {"parser_sandbox_max_bytes": 5000000})
	assert_true(to_bool(contains(dict_get_or(backslash_doc, "content", ""), "unix backslash filename")))
	double_slash_path := "/" + path_absolute(sample)
	double_slash_doc := parse_file(double_slash_path, {"parser_sandbox_max_bytes": 5000000})
	assert_true(to_bool(contains(dict_get_or(double_slash_doc, "content", ""), "portable descriptor-relative ingest")))
	delete_file(backslash_path)
}

delete_file(parent_root + "/parent-note.txt")
_ = os_rmdir(child_root)
_ = os_rmdir(parent_root)
delete_file(sample)
_ = os_rmdir(root)

print("test_descriptor_relative_ingest: ok")
