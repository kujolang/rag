from src.common import dict_get_or, read_json_file_or
from src.tests_helpers import assert_true

kujo_bin := env_or("KUJO_BIN", "/path/to/kujo/target/debug/kujo")

suffix := to_string(current_timestamp())
valid_plan_path := "/tmp/kujo_rag_threat_plan_valid_" + suffix + ".json"
invalid_plan_path := "/tmp/kujo_rag_threat_plan_invalid_" + suffix + ".json"
valid_output_path := "/tmp/kujo_rag_threat_review_valid_" + suffix + ".json"
invalid_output_path := "/tmp/kujo_rag_threat_review_invalid_" + suffix + ".json"
cadence_doc_path := "/tmp/kujo_rag_threat_doc_" + suffix + ".md"
release_doc_path := "/tmp/kujo_rag_threat_release_" + suffix + ".md"
workflow_path := "/tmp/kujo_rag_threat_workflow_" + suffix + ".yml"

write_file(cadence_doc_path, "# Threat Modeling and Security Review Cadence\n\n## Major Architectural Change Triggers\n- trigger\n\n## Security Review Checklist\n- item\n")
write_file(release_doc_path, "# Release Process\n\nSee " + cadence_doc_path + " for Security Review Checklist integration.\n")
write_file(workflow_path, "name: threat-model-review\non:\n  schedule:\n    - cron: '0 6 1 * *'\njobs:\n  review:\n    steps:\n      - run: kujo run scripts/run_threat_model_review_cadence.kujo --interpreter\n")

write_file(valid_plan_path, to_json({
	"version": "test-threat-v1",
	"last_reviewed_at_unix_ms": current_timestamp() - 1000,
	"review_cadence_days": 30,
	"owner": "Security Team",
	"major_change_triggers": ["auth model changes"],
	"release_milestones": [
		{
			"name": "M5",
			"threat_model_review_id": "TM-TEST-001",
			"reviewed_at_unix_ms": current_timestamp() - 1000,
			"reviewer": "Security Team"
		}
	]
}))

write_file(invalid_plan_path, to_json({
	"version": "test-threat-v1",
	"last_reviewed_at_unix_ms": current_timestamp() - (90 * 86400000),
	"review_cadence_days": 30,
	"owner": "",
	"major_change_triggers": [],
	"release_milestones": [
		{
			"name": "",
			"threat_model_review_id": "",
			"reviewed_at_unix_ms": 0
		}
	]
}))

valid_cmd := "KUJO_RAG_THREAT_MODEL_PLAN_PATH=" + valid_plan_path + " KUJO_RAG_THREAT_MODEL_REVIEW_OUTPUT_PATH=" + valid_output_path + " KUJO_RAG_THREAT_MODEL_CADENCE_DOC_PATH=" + cadence_doc_path + " KUJO_RAG_RELEASE_PROCESS_DOC_PATH=" + release_doc_path + " KUJO_RAG_THREAT_MODEL_WORKFLOW_PATH=" + workflow_path + " " + kujo_bin + " run scripts/run_threat_model_review_cadence.kujo --interpreter"
valid_res := execute_status(valid_cmd, {"timeout_ms": 240000})
assert_true(to_bool(type(valid_res) == "struct"))
assert_true(to_bool(valid_res.success == true))

valid_payload := read_json_file_or(valid_output_path, {})
assert_true(to_bool(dict_get_or(valid_payload, "ok", false) == true))
assert_true(to_bool(dict_get_or(dict_get_or(valid_payload, "gates", {}), "security_checklist_attached", false) == true))
assert_true(to_bool(dict_get_or(dict_get_or(valid_payload, "gates", {}), "workflow_defined", false) == true))

invalid_cmd := "KUJO_RAG_THREAT_MODEL_PLAN_PATH=" + invalid_plan_path + " KUJO_RAG_THREAT_MODEL_REVIEW_OUTPUT_PATH=" + invalid_output_path + " KUJO_RAG_THREAT_MODEL_CADENCE_DOC_PATH=" + cadence_doc_path + " KUJO_RAG_RELEASE_PROCESS_DOC_PATH=" + release_doc_path + " KUJO_RAG_THREAT_MODEL_WORKFLOW_PATH=" + workflow_path + " " + kujo_bin + " run scripts/run_threat_model_review_cadence.kujo --interpreter"
invalid_res := execute_status(invalid_cmd, {"timeout_ms": 240000})
assert_true(to_bool(type(invalid_res) == "struct"))
assert_true(to_bool(invalid_res.success == false))

invalid_payload := read_json_file_or(invalid_output_path, {})
assert_true(to_bool(dict_get_or(invalid_payload, "ok", true) == false))
invalid_gates := dict_get_or(invalid_payload, "gates", {})
assert_true(to_bool(dict_get_or(invalid_gates, "owner_defined", true) == false))
assert_true(to_bool(dict_get_or(invalid_gates, "triggers_defined", true) == false))
assert_true(to_bool(dict_get_or(invalid_gates, "review_not_overdue", true) == false))

if file_exists(valid_plan_path) {
	delete_file(valid_plan_path)
}
if file_exists(invalid_plan_path) {
	delete_file(invalid_plan_path)
}
if file_exists(valid_output_path) {
	delete_file(valid_output_path)
}
if file_exists(invalid_output_path) {
	delete_file(invalid_output_path)
}
if file_exists(cadence_doc_path) {
	delete_file(cadence_doc_path)
}
if file_exists(release_doc_path) {
	delete_file(release_doc_path)
}
if file_exists(workflow_path) {
	delete_file(workflow_path)
}

print("test_threat_model_review_cadence: ok")
