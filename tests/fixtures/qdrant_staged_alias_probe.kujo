from src.config import load_config
from src.common import dict_get_or, read_json_file_or
from src.vector_backend import load_index_with_backend, rollback_qdrant_generation, save_index_with_backend
from src.vector_store import empty_index, load_index_with_config, save_index_with_config

case_name := env_or("QDRANT_STAGED_CASE", "success")
mirror_path := "./results/test_qdrant_staged_alias_" + case_name + ".json"
journal_path := mirror_path + ".journal.json"
gc_enabled := case_name == "gc"
cfg := load_config({
	"vector_backend": "qdrant_http",
	"vector_backend_qdrant_url": env_or("QDRANT_STAGED_URL", "https://qdrant.internal:6333"),
	"vector_backend_qdrant_collection": "staged_security_probe",
	"vector_backend_qdrant_alias": "staged_security_probe_active",
	"vector_backend_qdrant_api_key": "staged-process-secret-marker",
	"vector_backend_qdrant_sync_enabled": true,
	"vector_backend_qdrant_sync_mode": "staged_alias",
	"vector_backend_qdrant_fail_open": false,
	"vector_backend_qdrant_mirror_path": mirror_path,
	"vector_backend_qdrant_journal_path": journal_path,
	"vector_backend_qdrant_gc_enabled": gc_enabled,
	"vector_backend_qdrant_gc_grace_sec": 60,
	"vector_backend_qdrant_gc_max_per_save": 1,
	"embedding_dims": 2
})

func fixture_index(label) {
	index := empty_index()
	index["chunks"] := [{
		"chunk_id": "chunk-" + label,
		"doc_id": "doc-" + label,
		"path": label + ".md",
		"line_start": 1,
		"line_end": 1,
		"text": "staged alias " + label
	}]
	index["vectors"] := [{"chunk_id": "chunk-" + label, "embedding": [0.1, 0.2]}]
	return index
}

func prior_fixture_index() {
	index := fixture_index("prior")
	meta := dict_get_or(index, "meta", {})
	meta["qdrant_generation"] := "prior_generation"
	index["meta"] := meta
	return index
}

if case_name == "lock_busy" {
	lock_path := journal_path + ".mutation-lock"
	create_dir(lock_path)
	result := save_index_with_backend(cfg, fixture_index("blocked"))
	journal := read_json_file_or(journal_path, {})
	lock_released := execute_status("rmdir '" + lock_path + "'", {"timeout_ms": 5000})
	if result != false || len(keys(journal)) != 0 || file_exists(journal_path + ".candidate.json") || lock_released.success != true {
		exit(1)
	}
	print(to_json({"ok": true, "case": case_name, "lock_enforced": true}))
	exit(0)
}

if case_name == "candidate_persist_failure" {
	candidate_path := journal_path + ".candidate.json"
	create_dir(candidate_path)
	result := save_index_with_backend(cfg, fixture_index("candidate-persist-failure"))
	_ = execute_status("rmdir '" + candidate_path + "'", {"timeout_ms": 5000})
	leak_check := execute_status("find ./results -maxdepth 1 -name 'test_qdrant_staged_alias_candidate_persist_failure.json.journal.json.previous.*.json' | wc -l", {"timeout_ms": 5000})
	if result != false || trim(to_string(leak_check.stdout)) != "0" {
		exit(1)
	}
	print(to_json({"ok": true, "case": case_name, "pre_journal_snapshot_cleaned": true}))
	exit(0)
}

if case_name == "journal_persist_failure" {
	create_dir(journal_path)
	result := save_index_with_backend(cfg, fixture_index("journal-persist-failure"))
	_ = execute_status("rmdir '" + journal_path + "'", {"timeout_ms": 5000})
	leak_check := execute_status("find ./results -maxdepth 1 \\( -name 'test_qdrant_staged_alias_journal_persist_failure.json.journal.json.previous.*.json' -o -name 'test_qdrant_staged_alias_journal_persist_failure.json.journal.json.candidate.json' \\) | wc -l", {"timeout_ms": 5000})
	if result != false || trim(to_string(leak_check.stdout)) != "0" {
		exit(1)
	}
	print(to_json({"ok": true, "case": case_name, "prepared_failure_artifacts_cleaned": true}))
	exit(0)
}

if case_name == "restart_recovery" {
	first_saved := save_index_with_backend(cfg, fixture_index("prior"))
	second_saved := save_index_with_backend(cfg, fixture_index("candidate"))
	committed_journal := read_json_file_or(journal_path, {})
	candidate_path := to_string(dict_get_or(committed_journal, "candidate_mirror_path", journal_path + ".candidate.json"))
	candidate_copy := write_file_atomic(candidate_path, read_file(mirror_path), true)
	committed_journal["candidate_mirror_sha256"] := to_string(sha256_file(candidate_path))
	prior_restored := save_index_with_config(mirror_path, fixture_index("prior"), cfg)
	committed_journal["phase"] := "alias_committed"
	journal_seeded := write_file_atomic(journal_path, to_json(committed_journal), true)
	recovered := load_index_with_backend(cfg)
	recovered_chunks := dict_get_or(recovered, "chunks", [])
	recovered_journal := read_json_file_or(journal_path, {})
	if first_saved != true || second_saved != true || candidate_copy != true || prior_restored != true || journal_seeded != true || len(recovered_chunks) != 1 || dict_get_or(recovered_chunks[0], "chunk_id", "") != "chunk-candidate" || dict_get_or(recovered_journal, "phase", "") != "mirror_committed" || dict_get_or(recovered_journal, "recovery_action", "") != "completed_forward" || file_exists(candidate_path) {
		exit(1)
	}
	print(to_json({"ok": true, "case": case_name, "restart_recovered": true}))
	exit(0)
}

if case_name == "gc" {
	first_saved := save_index_with_backend(cfg, fixture_index("prior"))
	gc_journal := read_json_file_or(journal_path, {})
	gc_journal["gc_pending"] := [{"collection": "staged_security_probe__gen_stale", "reason": "test_stale", "recorded_at_unix_ms": 0, "eligible_after_unix_ms": 0}]
	journal_seeded := write_file_atomic(journal_path, to_json(gc_journal), true)
	second_saved := save_index_with_backend(cfg, fixture_index("candidate"))
	final_journal := read_json_file_or(journal_path, {})
	deleted := dict_get_or(final_journal, "gc_last_deleted", [])
	if first_saved != true || journal_seeded != true || second_saved != true || len(deleted) != 1 || deleted[0] != "staged_security_probe__gen_stale" || len(dict_get_or(final_journal, "gc_pending", [])) < 1 {
		exit(1)
	}
	print(to_json({"ok": true, "case": case_name, "bounded_gc": true}))
	exit(0)
}

if case_name == "rollback" {
	first_saved := save_index_with_backend(cfg, fixture_index("prior"))
	second_saved := save_index_with_backend(cfg, fixture_index("candidate"))
	rolled_back := rollback_qdrant_generation(cfg)
	restored := load_index_with_backend(cfg)
	rollback_journal := read_json_file_or(journal_path, {})
	restored_chunks := dict_get_or(restored, "chunks", [])
	if first_saved != true || second_saved != true || dict_get_or(rolled_back, "ok", false) != true || len(restored_chunks) != 1 || dict_get_or(restored_chunks[0], "chunk_id", "") != "chunk-prior" || dict_get_or(dict_get_or(restored, "meta", {}), "qdrant_generation", "") != dict_get_or(rollback_journal, "previous_collection", "") || dict_get_or(dict_get_or(restored, "meta", {}), "qdrant_recovery_required", false) == true || dict_get_or(rollback_journal, "phase", "") != "rolled_back" || dict_get_or(rollback_journal, "rollback_action", "") != "restored_previous_generation" {
		exit(1)
	}
	print(to_json({"ok": true, "case": case_name, "rolled_back": true}))
	exit(0)
}

if case_name == "rollback_tamper" {
	first_saved := save_index_with_backend(cfg, fixture_index("prior"))
	second_saved := save_index_with_backend(cfg, fixture_index("candidate"))
	tamper_journal := read_json_file_or(journal_path, {})
	rollback_path := to_string(dict_get_or(tamper_journal, "rollback_mirror_path", ""))
	tampered := read_json_file_or(rollback_path, {})
	tampered_chunks := dict_get_or(tampered, "chunks", [])
	if len(tampered_chunks) > 0 {
		tampered_chunk := tampered_chunks[0]
		tampered_chunk["text"] := "tampered local-only rollback content"
		tampered_chunks[0] = tampered_chunk
	}
	tampered["chunks"] := tampered_chunks
	tamper_written := write_file_atomic(rollback_path, to_json(tampered), true)
	rolled_back := rollback_qdrant_generation(cfg)
	final_journal := read_json_file_or(journal_path, {})
	if first_saved != true || second_saved != true || tamper_written != true || dict_get_or(rolled_back, "ok", true) != false || dict_get_or(dict_get_or(rolled_back, "error", {}), "code", "") != "qdrant_rollback_mirror_digest_mismatch" || dict_get_or(final_journal, "phase", "") != "mirror_committed" {
		exit(1)
	}
	print(to_json({"ok": true, "case": case_name, "tamper_rejected": true}))
	exit(0)
}

if case_name == "rollback_readback_failure" {
	first_saved := save_index_with_backend(cfg, fixture_index("prior"))
	second_saved := save_index_with_backend(cfg, fixture_index("candidate"))
	marker_path := env_or("FAKE_QDRANT_BAD_READBACK_MARKER", "")
	marker_written := marker_path != "" && write_file_atomic(marker_path, "1", true)
	rolled_back := rollback_qdrant_generation(cfg)
	if marker_path != "" && file_exists(marker_path) {
		delete_file(marker_path)
	}
	active := load_index_with_backend(cfg)
	active_chunks := dict_get_or(active, "chunks", [])
	final_journal := read_json_file_or(journal_path, {})
	if first_saved != true || second_saved != true || marker_written != true || dict_get_or(rolled_back, "ok", true) != false || dict_get_or(dict_get_or(rolled_back, "error", {}), "code", "") != "qdrant_rollback_readback_verification_failed" || len(active_chunks) != 1 || dict_get_or(active_chunks[0], "chunk_id", "") != "chunk-candidate" || dict_get_or(final_journal, "phase", "") != "mirror_committed" {
		exit(1)
	}
	print(to_json({"ok": true, "case": case_name, "rollback_readback_rejected": true}))
	exit(0)
}

if case_name == "failed_next_then_rollback" {
	first_saved := save_index_with_backend(cfg, fixture_index("prior"))
	second_saved := save_index_with_backend(cfg, fixture_index("candidate"))
	third_saved := save_index_with_backend(cfg, fixture_index("failed-next"))
	failed_journal := read_json_file_or(journal_path, {})
	failed_snapshot_path := to_string(dict_get_or(failed_journal, "rollback_mirror_path", ""))
	fake_count_path := env_or("FAKE_QDRANT_STATE_FILE", "")
	if fake_count_path != "" {
		write_file_atomic(fake_count_path, "1", true)
	}
	rolled_back := rollback_qdrant_generation(cfg)
	restored := load_index_with_backend(cfg)
	restored_chunks := dict_get_or(restored, "chunks", [])
	if first_saved != true || second_saved != true || third_saved != false || failed_snapshot_path == "" || file_exists(failed_snapshot_path) || dict_get_or(rolled_back, "ok", false) != true || len(restored_chunks) != 1 || dict_get_or(restored_chunks[0], "chunk_id", "") != "chunk-prior" {
		exit(1)
	}
	print(to_json({"ok": true, "case": case_name, "rollback_history_preserved": true}))
	exit(0)
}

if case_name == "failure" || case_name == "digest_failure" || case_name == "readback_failure" {
	seeded := save_index_with_config(mirror_path, prior_fixture_index(), cfg)
	if seeded != true {
		exit(1)
	}
	result := save_index_with_backend(cfg, fixture_index("candidate"))
	preserved := load_index_with_config(mirror_path, cfg)
	journal := read_json_file_or(journal_path, {})
	if result != false || len(dict_get_or(preserved, "chunks", [])) != 1 || dict_get_or(dict_get_or(preserved, "chunks", [])[0], "chunk_id", "") != "chunk-prior" || dict_get_or(journal, "phase", "") != "failed" {
		exit(1)
	}
	print(to_json({"ok": true, "case": case_name, "mirror_preserved": true}))
	exit(0)
}

if case_name == "alias_failure" {
	seeded := save_index_with_config(mirror_path, prior_fixture_index(), cfg)
	if seeded != true {
		exit(1)
	}
	result := save_index_with_backend(cfg, fixture_index("candidate"))
	preserved := load_index_with_config(mirror_path, cfg)
	recovery_view := load_index_with_backend(cfg)
	journal := read_json_file_or(journal_path, {})
	recovered_chunks := dict_get_or(recovery_view, "chunks", [])
	if result != false || len(dict_get_or(preserved, "chunks", [])) != 1 || len(recovered_chunks) != 1 || dict_get_or(recovered_chunks[0], "chunk_id", "") != "chunk-candidate" || dict_get_or(journal, "phase", "") != "mirror_committed" || dict_get_or(journal, "recovery_action", "") != "completed_forward" {
		exit(1)
	}
	print(to_json({"ok": true, "case": case_name, "ambiguous_commit_recovered": true}))
	exit(0)
}

if case_name == "recovery_guard" {
	seeded := save_index_with_config(mirror_path, fixture_index("prior"), cfg)
	if seeded != true {
		exit(1)
	}
	recovery_journal := {
		"schema_version": 1,
		"mode": "staged_alias",
		"phase": "alias_committed",
		"alias": "staged_security_probe_active",
		"candidate_collection": "unreconciled_generation",
		"previous_collection": "prior_generation"
	}
	journal_written := write_file_atomic(journal_path, to_json(recovery_journal), true)
	result := save_index_with_backend(cfg, fixture_index("candidate"))
	preserved_journal := read_json_file_or(journal_path, {})
	if journal_written != true || result != false || dict_get_or(preserved_journal, "phase", "") != "alias_committed" || dict_get_or(preserved_journal, "candidate_collection", "") != "unreconciled_generation" {
		exit(1)
	}
	print(to_json({"ok": true, "case": case_name, "recovery_evidence_preserved": true}))
	exit(0)
}

index := fixture_index("success")
if case_name == "empty" {
	index = empty_index()
}
result := save_index_with_backend(cfg, index)
if case_name == "success" && result == true {
	index = fixture_index("second")
	result = save_index_with_backend(cfg, index)
}
journal := read_json_file_or(journal_path, {})
loaded := load_index_with_config(mirror_path, cfg)
expected_points := 1
if case_name == "empty" {
	expected_points = 0
}
if result != true || dict_get_or(journal, "phase", "") != "mirror_committed" || dict_get_or(journal, "expected_points", -1) != expected_points || dict_get_or(dict_get_or(loaded, "meta", {}), "qdrant_generation", "") == "" {
	exit(1)
}
print(to_json({"ok": true, "case": case_name, "expected_points": expected_points}))
