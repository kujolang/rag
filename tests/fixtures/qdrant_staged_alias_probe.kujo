from src.config import load_config
from src.common import dict_get_or, read_json_file_or
from src.vector_backend import load_index_with_backend, save_index_with_backend
from src.vector_store import empty_index, load_index_with_config, save_index_with_config

case_name := env_or("QDRANT_STAGED_CASE", "success")
mirror_path := "./results/test_qdrant_staged_alias_" + case_name + ".json"
journal_path := mirror_path + ".journal.json"
cfg := load_config({
	"vector_backend": "qdrant_http",
	"vector_backend_qdrant_url": env_or("QDRANT_STAGED_URL", "https://qdrant.internal:6333"),
	"vector_backend_qdrant_collection": "staged_security_probe",
	"vector_backend_qdrant_alias": "staged_security_probe_active",
	"vector_backend_qdrant_api_key": "staged-process-secret-marker",
	"vector_backend_qdrant_sync_enabled": true,
	"vector_backend_qdrant_sync_mode": "staged_alias",
	"vector_backend_qdrant_fail_open": false,
	"vector_backend_qdrant_mirror_path": mirror_path,
	"vector_backend_qdrant_journal_path": journal_path,
	"embedding_dims": 2
})

func fixture_index(label) {
	index := empty_index()
	index["chunks"] := [{
		"chunk_id": "chunk-" + label,
		"doc_id": "doc-" + label,
		"path": label + ".md",
		"line_start": 1,
		"line_end": 1,
		"text": "staged alias " + label
	}]
	index["vectors"] := [{"chunk_id": "chunk-" + label, "embedding": [0.1, 0.2]}]
	return index
}

if case_name == "failure" {
	seeded := save_index_with_config(mirror_path, fixture_index("prior"), cfg)
	if seeded != true {
		exit(1)
	}
	result := save_index_with_backend(cfg, fixture_index("candidate"))
	preserved := load_index_with_config(mirror_path, cfg)
	journal := read_json_file_or(journal_path, {})
	if result != false || len(dict_get_or(preserved, "chunks", [])) != 1 || dict_get_or(dict_get_or(preserved, "chunks", [])[0], "chunk_id", "") != "chunk-prior" || dict_get_or(journal, "phase", "") != "failed" {
		exit(1)
	}
	print(to_json({"ok": true, "case": case_name, "mirror_preserved": true}))
	exit(0)
}

if case_name == "alias_failure" {
	seeded := save_index_with_config(mirror_path, fixture_index("prior"), cfg)
	if seeded != true {
		exit(1)
	}
	result := save_index_with_backend(cfg, fixture_index("candidate"))
	preserved := load_index_with_config(mirror_path, cfg)
	journal := read_json_file_or(journal_path, {})
	recovery_view := load_index_with_backend(cfg)
	load_error := dict_get_or(dict_get_or(recovery_view, "meta", {}), "load_error", {})
	if result != false || len(dict_get_or(preserved, "chunks", [])) != 1 || dict_get_or(journal, "phase", "") != "alias_commit_ambiguous" || dict_get_or(load_error, "code", "") != "qdrant_recovery_required" {
		exit(1)
	}
	print(to_json({"ok": true, "case": case_name, "ambiguous_commit_detected": true}))
	exit(0)
}

if case_name == "recovery_guard" {
	seeded := save_index_with_config(mirror_path, fixture_index("prior"), cfg)
	if seeded != true {
		exit(1)
	}
	recovery_journal := {
		"schema_version": 1,
		"mode": "staged_alias",
		"phase": "alias_committed",
		"alias": "staged_security_probe_active",
		"candidate_collection": "unreconciled_generation",
		"previous_collection": "prior_generation"
	}
	journal_written := write_file_atomic(journal_path, to_json(recovery_journal), true)
	result := save_index_with_backend(cfg, fixture_index("candidate"))
	preserved_journal := read_json_file_or(journal_path, {})
	if journal_written != true || result != false || dict_get_or(preserved_journal, "phase", "") != "alias_committed" || dict_get_or(preserved_journal, "candidate_collection", "") != "unreconciled_generation" {
		exit(1)
	}
	print(to_json({"ok": true, "case": case_name, "recovery_evidence_preserved": true}))
	exit(0)
}

index := fixture_index("success")
if case_name == "empty" {
	index = empty_index()
}
result := save_index_with_backend(cfg, index)
if case_name == "success" && result == true {
	index = fixture_index("second")
	result = save_index_with_backend(cfg, index)
}
journal := read_json_file_or(journal_path, {})
loaded := load_index_with_config(mirror_path, cfg)
expected_points := 1
if case_name == "empty" {
	expected_points = 0
}
if result != true || dict_get_or(journal, "phase", "") != "mirror_committed" || dict_get_or(journal, "expected_points", -1) != expected_points || dict_get_or(dict_get_or(loaded, "meta", {}), "qdrant_generation", "") == "" {
	exit(1)
}
print(to_json({"ok": true, "case": case_name, "expected_points": expected_points}))
