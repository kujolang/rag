from src.release_eval import run_release_evaluation
from src.common import dict_get_or
from src.tests_helpers import assert_true

result := run_release_evaluation({
	"golden_queries_path": "./config/release_eval_golden_queries.json",
	"thresholds_path": "./config/release_eval_thresholds.json",
	"corpus_path": "./examples/release_eval_corpus",
	"index_path": "./results/test_release_eval_index.json",
	"recursive": true
})

assert_true(to_bool(has_key(result, "ok") == 1))
assert_true(to_bool(has_key(result, "metrics") == 1))
assert_true(to_bool(has_key(result, "gates") == 1))
assert_true(to_bool(has_key(result, "dataset_version") == 1))
assert_true(to_bool(dict_get_or(result, "dataset_version", "") != ""))
assert_true(to_bool(dict_get_or(dict_get_or(result, "metrics", {}), "total_cases", 0) >= 12 && dict_get_or(dict_get_or(result, "metrics", {}), "avg_grounding", 0.0) >= 0.5 && len(dict_get_or(dict_get_or(result, "metrics", {}), "domain_summary", [])) >= 6))
assert_true(to_bool(dict_get_or(dict_get_or(result, "gates", {}), "minimum_case_count", false) == true && dict_get_or(dict_get_or(result, "gates", {}), "avg_grounding", false) == true))
assert_true(to_bool(dict_get_or(result, "ok", false) == true))

if file_exists("./results/test_release_eval_index.json") {
	delete_file("./results/test_release_eval_index.json")
}

print("test_release_evaluation: ok")
