from src.tests_helpers import assert_true
from src.common import dict_get_or
from src.config import load_config, validate_config

func has_error_code(diagnostics, code) {
	errors := dict_get_or(diagnostics, "errors", [])
	i := 0
	while i < len(errors) {
		entry := errors[i]
		if dict_get_or(entry, "code", "") == code {
			return true
		}
		i = i + 1
	}
	return false
}

valid_cfg := load_config({
	"index_path": "./data/config_integrity_valid.json",
	"api_host": "127.0.0.1",
	"api_port": 8787,
	"api_ingest_allowed_roots": ["./examples"],
	"strict_config": false,
	"runtime_environment": "development"
})
valid_diag := validate_config(valid_cfg)
assert_true(to_bool(dict_get_or(valid_diag, "ok", false) == true))

invalid_cfg := load_config({
	"index_path": "",
	"api_host": "",
	"api_port": 70000,
	"api_ingest_allowed_roots": []
})
invalid_diag := validate_config(invalid_cfg)
assert_true(to_bool(dict_get_or(invalid_diag, "ok", true) == false))
assert_true(to_bool(has_error_code(invalid_diag, "index_path_required") == true))
assert_true(to_bool(has_error_code(invalid_diag, "api_host_required") == true))
assert_true(to_bool(has_error_code(invalid_diag, "api_port_out_of_range") == true))
assert_true(to_bool(has_error_code(invalid_diag, "ingest_allowed_roots_required") == true))

strict_invalid_cfg := load_config({
	"strict_config": true,
	"runtime_environment": "production",
	"api_bearer_token": "",
	"at_rest_encryption_enabled": false,
	"at_rest_encryption_key": "",
	"namespace": "default",
	"index_path": "./data/rag_index.json",
	"api_ingest_allowed_roots": ["./examples"]
})
strict_invalid_diag := validate_config(strict_invalid_cfg)
assert_true(to_bool(dict_get_or(strict_invalid_diag, "ok", true) == false))
assert_true(to_bool(dict_get_or(strict_invalid_diag, "strict_mode", false) == true))
assert_true(to_bool(has_error_code(strict_invalid_diag, "strict_requires_api_bearer_token") == true))
assert_true(to_bool(has_error_code(strict_invalid_diag, "strict_requires_namespace_override") == true))
assert_true(to_bool(has_error_code(strict_invalid_diag, "strict_requires_index_path_override") == true))
assert_true(to_bool(has_error_code(strict_invalid_diag, "strict_requires_at_rest_encryption") == true))
assert_true(to_bool(has_error_code(strict_invalid_diag, "strict_requires_encryption_key") == true))
assert_true(to_bool(has_error_code(strict_invalid_diag, "strict_requires_rbac") == true))
assert_true(to_bool(has_error_code(strict_invalid_diag, "strict_requires_audit") == true))
assert_true(to_bool(has_error_code(strict_invalid_diag, "strict_requires_audit_fail_closed") == true))
assert_true(to_bool(has_error_code(strict_invalid_diag, "strict_requires_audit_integrity_key") == true))

strict_valid_cfg := load_config({
	"strict_config": true,
	"runtime_environment": "production",
	"api_bearer_token": "prod-token",
	"at_rest_encryption_enabled": true,
	"at_rest_encryption_key": "prod-encryption-key",
	"namespace": "tenant_prod",
	"index_path": "./data/tenant_prod_index.json",
	"api_ingest_allowed_roots": ["./examples"],
	"api_host": "0.0.0.0",
	"api_allow_non_loopback": true,
	"api_rbac_enabled": true,
	"api_rbac_default_role": "reader",
	"api_audit_enabled": true,
	"api_audit_path": "./results/test_config_integrity_audit.log",
	"api_audit_fail_closed": true,
	"api_audit_integrity_key": "test-only-audit-integrity-key",
	"api_port": 8787
})
strict_valid_diag := validate_config(strict_valid_cfg)
assert_true(to_bool(dict_get_or(strict_valid_diag, "ok", false) == true))
assert_true(to_bool(dict_get_or(strict_valid_diag, "strict_mode", false) == true))

public_without_opt_in := load_config({
	"api_host": "0.0.0.0",
	"api_allow_non_loopback": false
})
public_without_opt_in_diag := validate_config(public_without_opt_in)
assert_true(to_bool(dict_get_or(public_without_opt_in_diag, "ok", true) == false))
assert_true(to_bool(has_error_code(public_without_opt_in_diag, "non_loopback_requires_explicit_opt_in") == true))

strict_privileged_default := load_config({
	"strict_config": true,
	"runtime_environment": "production",
	"api_bearer_token": "prod-token",
	"at_rest_encryption_enabled": true,
	"at_rest_encryption_key": "prod-encryption-key",
	"namespace": "tenant_prod",
	"index_path": "./data/tenant_prod_index.json",
	"api_ingest_allowed_roots": ["./examples"],
	"api_rbac_enabled": true,
	"api_rbac_default_role": "admin",
	"api_audit_enabled": true,
	"api_audit_path": "./results/test_config_integrity_audit.log",
	"api_audit_fail_closed": true,
	"api_audit_integrity_key": "test-only-audit-integrity-key"
})
strict_privileged_default_diag := validate_config(strict_privileged_default)
assert_true(to_bool(has_error_code(strict_privileged_default_diag, "strict_disallows_privileged_rbac_default") == true))

strict_qdrant_invalid := load_config({
	"strict_config": true,
	"runtime_environment": "production",
	"api_bearer_token": "prod-token",
	"at_rest_encryption_enabled": true,
	"at_rest_encryption_key": "prod-encryption-key",
	"namespace": "tenant_prod",
	"index_path": "./data/tenant_prod_index.json",
	"api_ingest_allowed_roots": ["./examples"],
	"api_rbac_enabled": true,
	"api_rbac_default_role": "reader",
	"api_audit_enabled": true,
	"api_audit_path": "./results/test_config_integrity_audit.log",
	"api_audit_fail_closed": true,
	"api_audit_integrity_key": "test-only-audit-integrity-key",
	"vector_backend": "qdrant_http",
	"vector_backend_qdrant_sync_enabled": true,
	"vector_backend_qdrant_url": "http://qdrant.internal:6333",
	"vector_backend_qdrant_fail_open": true,
	"vector_backend_qdrant_allowed_hosts": []
})
strict_qdrant_invalid_diag := validate_config(strict_qdrant_invalid)
assert_true(to_bool(has_error_code(strict_qdrant_invalid_diag, "strict_requires_qdrant_https") == true))
assert_true(to_bool(has_error_code(strict_qdrant_invalid_diag, "strict_disallows_qdrant_fail_open") == true))
assert_true(to_bool(has_error_code(strict_qdrant_invalid_diag, "strict_requires_qdrant_host_allowlist") == true))
assert_true(to_bool(has_error_code(strict_qdrant_invalid_diag, "strict_requires_qdrant_staged_alias") == true))

strict_qdrant_valid := load_config({
	"strict_config": true,
	"runtime_environment": "production",
	"api_bearer_token": "prod-token",
	"at_rest_encryption_enabled": true,
	"at_rest_encryption_key": "prod-encryption-key",
	"namespace": "tenant_prod",
	"index_path": "./data/tenant_prod_index.json",
	"api_ingest_allowed_roots": ["./examples"],
	"api_rbac_enabled": true,
	"api_rbac_default_role": "reader",
	"api_audit_enabled": true,
	"api_audit_path": "./results/test_config_integrity_audit.log",
	"api_audit_fail_closed": true,
	"api_audit_integrity_key": "test-only-audit-integrity-key",
	"vector_backend": "qdrant_http",
	"vector_backend_qdrant_sync_enabled": true,
	"vector_backend_qdrant_url": "https://qdrant.internal:6333",
	"vector_backend_qdrant_sync_mode": "staged_alias",
	"vector_backend_qdrant_fail_open": false,
	"vector_backend_qdrant_allowed_hosts": ["qdrant.internal"]
})
strict_qdrant_valid_diag := validate_config(strict_qdrant_valid)
assert_true(to_bool(dict_get_or(strict_qdrant_valid_diag, "ok", false) == true))

invalid_qdrant_mode_cfg := load_config({
	"vector_backend": "qdrant_http",
	"vector_backend_qdrant_sync_mode": "staged_alis"
})
invalid_qdrant_mode_diag := validate_config(invalid_qdrant_mode_cfg)
assert_true(to_bool(dict_get_or(invalid_qdrant_mode_diag, "ok", true) == false))
assert_true(to_bool(has_error_code(invalid_qdrant_mode_diag, "invalid_qdrant_sync_mode") == true))

bounded_qdrant_gc_cfg := load_config({
	"vector_backend_qdrant_gc_grace_sec": 0,
	"vector_backend_qdrant_gc_max_per_save": 100
})
assert_true(to_bool(dict_get_or(bounded_qdrant_gc_cfg, "vector_backend_qdrant_gc_grace_sec", 0) == 60))
assert_true(to_bool(dict_get_or(bounded_qdrant_gc_cfg, "vector_backend_qdrant_gc_max_per_save", 0) == 10))

bounded_parser_cfg := load_config({
	"parser_sandbox_max_bytes": 10000000
})
assert_true(to_bool(dict_get_or(bounded_parser_cfg, "parser_sandbox_max_bytes", 0) == 8388608))

print("test_config_integrity: ok")
