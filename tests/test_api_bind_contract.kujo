from src.tests_helpers import assert_true

source := read_file("src/query_api.kujo")
assert_true(to_bool(contains(source, "server := http_listen(host, port)")))
if contains(source, "server := http_server(port)") {
	print("test_api_bind_contract assertion failed: legacy wildcard listener remains")
	exit(1)
}
print("source_contract: ok")

print("test_api_bind_contract: ok")
