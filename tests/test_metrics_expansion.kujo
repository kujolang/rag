from src.common import dict_get_or
from src.tests_helpers import assert_true

kujo_bin := env_or("KUJO_BIN", "/path/to/kujo/target/release/kujo")

func run_cmd(command) {
	res := execute_status(command, {"timeout_ms": 120000})
	if type(res) == "struct" {
		return {
			"ok": res.success,
			"exit_code": res.exitcode,
			"stdout": to_string(res.stdout),
			"stderr": to_string(res.stderr)
		}
	}
	return {
		"ok": false,
		"exit_code": -1,
		"stdout": "",
		"stderr": "invalid execute_status result"
	}
}

func parse_json_safe(text) {
	obj := {}
	err := null
	try {
		obj := parse_json(text)
	} except e {
		err := e
	}
	if type(err) != "null" {
		return {
			"ok": false,
			"error": to_string(err),
			"data": {}
		}
	}
	return {
		"ok": true,
		"data": obj
	}
}

func start_server(port, env_prefix, log_file) {
	cmd := "env " + env_prefix + " " + kujo_bin + " run main.kujo --interpreter serve --host 127.0.0.1 --port " + to_string(port) + " > " + log_file + " 2>&1 & echo $!"
	res := run_cmd(cmd)
	pid := trim(dict_get_or(res, "stdout", ""))
	return pid
}

func stop_server(pid) {
	if pid == "" {
		return true
	}
	_ := run_cmd("kill -KILL " + pid + " >/dev/null 2>&1 || true")
	_ := run_cmd("wait " + pid + " >/dev/null 2>&1 || true")
	return true
}

func wait_for_health(port) {
	attempt := 0
	while attempt < 1200 {
		res := run_cmd("curl -s http://127.0.0.1:" + to_string(port) + "/health")
		body := trim(dict_get_or(res, "stdout", ""))
		if body != "" {
			parsed := parse_json_safe(body)
			if dict_get_or(parsed, "ok", false) == true {
				payload := dict_get_or(parsed, "data", {})
				if dict_get_or(payload, "ok", false) == true {
					return true
				}
			}
		}
		attempt = attempt + 1
	}
	return false
}

func post_json(port, path, payload) {
	cmd := "curl -s -X POST http://127.0.0.1:" + to_string(port) + path + " -H \"Content-Type: application/json\" -d '" + payload + "'"
	return run_cmd(cmd)
}

port := 42000 + (current_timestamp() % 10000)
env_prefix := "KUJO_RAG_ENV=development KUJO_RAG_API_AUTH_PROVIDER=none"
pid := start_server(port, env_prefix, "/tmp/kujo_rag_metrics_expansion.log")
assert_true(to_bool(pid != ""))
assert_true(to_bool(wait_for_health(port) == true))

ingest_res := post_json(port, "/ingest", "{\"path\":\"./examples/kujo_docs\",\"recursive\":true,\"namespace\":\"alpha\"}")
ingest_parsed := parse_json_safe(dict_get_or(ingest_res, "stdout", ""))
assert_true(to_bool(dict_get_or(ingest_parsed, "ok", false) == true))
assert_true(to_bool(dict_get_or(dict_get_or(ingest_parsed, "data", {}), "ok", false) == true))

_ = post_json(port, "/query", "{\"query\":\"Kujo speed\",\"namespace\":\"alpha\",\"session_id\":\"m1\"}")
_ = post_json(port, "/query", "{\"query\":\"Kujo speed\",\"namespace\":\"alpha\",\"session_id\":\"m1\"}")

metrics_res := run_cmd("curl -s http://127.0.0.1:" + to_string(port) + "/metrics")
metrics_parsed := parse_json_safe(dict_get_or(metrics_res, "stdout", ""))
assert_true(to_bool(dict_get_or(metrics_parsed, "ok", false) == true))
metrics_payload := dict_get_or(metrics_parsed, "data", {})
assert_true(to_bool(dict_get_or(metrics_payload, "ok", false) == true))
metrics := dict_get_or(metrics_payload, "data", {})

assert_true(to_bool(has_key(metrics, "ingest_latency_percentiles_ms") == 1))
assert_true(to_bool(has_key(metrics, "query_latency_percentiles_ms") == 1))
assert_true(to_bool(has_key(metrics, "ingest_queue_depth") == 1))
assert_true(to_bool(has_key(metrics, "ingest_throughput_per_min") == 1))
assert_true(to_bool(has_key(metrics, "auth_failures") == 1))
assert_true(to_bool(has_key(metrics, "cache_hits") == 1))
assert_true(to_bool(has_key(metrics, "cache_misses") == 1))
assert_true(to_bool(has_key(metrics, "cache_hit_ratio") == 1))
assert_true(to_bool(has_key(metrics, "error_cardinality") == 1))
assert_true(to_bool(has_key(metrics, "tenant_views") == 1))
assert_true(to_bool(has_key(metrics, "tenant_quota") == 1))

tenant_views := dict_get_or(metrics, "tenant_views", {})
assert_true(to_bool(type(tenant_views) == "dict"))
assert_true(to_bool(has_key(tenant_views, "alpha") == 1))
alpha_metrics := dict_get_or(tenant_views, "alpha", {})
assert_true(to_bool(dict_get_or(alpha_metrics, "ingest_requests", 0) >= 1))
assert_true(to_bool(dict_get_or(alpha_metrics, "query_requests", 0) >= 1))
assert_true(to_bool(has_key(alpha_metrics, "quota_rejections") == 1))

tenant_quota := dict_get_or(metrics, "tenant_quota", {})
assert_true(to_bool(has_key(tenant_quota, "enabled") == 1))
assert_true(to_bool(has_key(tenant_quota, "rejections") == 1))

_ := stop_server(pid)

print("test_metrics_expansion: ok")
