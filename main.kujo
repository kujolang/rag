from src.env_loader import load_dot_env
from src.config import load_config, ensure_runtime_dirs, cfg_with_namespace, validate_config
from src.common import dict_get_or
from src.cli_args import parse_cli, bool_from_flag, parse_int_flag
from src.rag_engine import build_rag_index, load_or_initialize_index, query_rag
from src.query_api import start_api_server
from src.bootstrap import bootstrap_repository

func print_help() {
	print("Kujo RAG Starter Kit")
	print("")
	print("Usage:")
	print("  kujo run main.kujo --interpreter ingest --path ./docs --recursive true")
	print("  kujo run main.kujo --interpreter ingest --path ./docs --namespace team_a")
	print("  kujo run main.kujo --interpreter query --question \"What is Kujo?\"")
	print("  kujo run main.kujo --interpreter query --question \"What is Kujo?\" --namespace team_a")
	print("  kujo run main.kujo --interpreter serve --port 8787")
	print("  kujo run main.kujo --interpreter demo")
	print("  kujo run main.kujo --interpreter bootstrap --target ./results/bootstrap_repo")
	print("")
	print("Commands:")
	print("  ingest   Build the index from local files")
	print("  query    Run hybrid retrieval and return citations")
	print("  serve    Start HTTP API")
	print("  demo     Run Kujo docs assistant demo")
	print("  bootstrap Generate an adoption-ready starter template")
}

func command_ingest(parsed, cfg) {
	flags := parsed["flags"]
	path := dict_get_or(flags, "path", ".")
	recursive := bool_from_flag(flags, "recursive", true)
	namespace_value := dict_get_or(flags, "namespace", dict_get_or(cfg, "namespace", "default"))
	ns_result := cfg_with_namespace(cfg, namespace_value)
	if dict_get_or(ns_result, "ok", false) == false {
		print(to_json({
			"ok": false,
			"error": dict_get_or(ns_result, "error", "invalid_namespace"),
			"message": dict_get_or(ns_result, "message", "Invalid namespace"),
			"details": dict_get_or(ns_result, "details", {})
		}))
		exit(1)
	}
	active_cfg := dict_get_or(ns_result, "cfg", cfg)
	active_namespace := dict_get_or(ns_result, "namespace", dict_get_or(cfg, "namespace", "default"))

	result := build_rag_index(path, active_cfg, recursive)
	print(to_json({
		"ok": true,
		"command": "ingest",
		"namespace": active_namespace,
		"index_path": dict_get_or(active_cfg, "index_path", ""),
		"path": path,
		"recursive": recursive,
		"summary": dict_get_or(result, "summary", {}),
		"stats": dict_get_or(dict_get_or(result, "ingest", {}), "stats", {}),
		"errors": dict_get_or(dict_get_or(result, "ingest", {}), "errors", [])
	}))
}

func command_query(parsed, cfg) {
	flags := parsed["flags"]
	namespace_value := dict_get_or(flags, "namespace", dict_get_or(cfg, "namespace", "default"))
	ns_result := cfg_with_namespace(cfg, namespace_value)
	if dict_get_or(ns_result, "ok", false) == false {
		print(to_json({
			"ok": false,
			"error": dict_get_or(ns_result, "error", "invalid_namespace"),
			"message": dict_get_or(ns_result, "message", "Invalid namespace"),
			"details": dict_get_or(ns_result, "details", {})
		}))
		exit(1)
	}
	active_cfg := dict_get_or(ns_result, "cfg", cfg)
	active_namespace := dict_get_or(ns_result, "namespace", dict_get_or(cfg, "namespace", "default"))

	question := dict_get_or(flags, "question", "")
	if question == "" {
		positionals := parsed["positionals"]
		if len(positionals) > 0 {
			question := join(positionals, " ")
		}
	}
	if trim(question) == "" {
		print(to_json({
			"ok": false,
			"error": "missing_question",
			"message": "Provide --question or trailing query text"
		}))
		exit(1)
	}

	index := load_or_initialize_index(active_cfg)
	result := query_rag(index, question, active_cfg, null, null)
	result["namespace"] := active_namespace
	print(to_json(result))
}

func command_demo(cfg) {
	demo_path := "./examples/kujo_docs"
	question := "What is Kujo and what does it optimize for?"
	ns_result := cfg_with_namespace(cfg, dict_get_or(cfg, "namespace", "default"))
	active_cfg := dict_get_or(ns_result, "cfg", cfg)
	active_namespace := dict_get_or(ns_result, "namespace", dict_get_or(cfg, "namespace", "default"))

	index_result := build_rag_index(demo_path, active_cfg, true)
	index := dict_get_or(index_result, "index", {})
	result := query_rag(index, question, active_cfg, null, null)
	print(to_json({
		"demo": true,
		"namespace": active_namespace,
		"question": question,
		"answer": dict_get_or(result, "answer", ""),
		"citations": dict_get_or(result, "citations", [])
	}))
}

func command_serve(parsed, cfg) {
	flags := parsed["flags"]
	port_result := parse_int_flag(flags, "port", dict_get_or(cfg, "api_port", 8787))
	if port_result["ok"] == false {
		print(to_json({
			"ok": false,
			"error": dict_get_or(port_result, "error", "invalid_int_flag"),
			"message": dict_get_or(port_result, "message", "Invalid numeric flag value"),
			"details": dict_get_or(port_result, "details", {})
		}))
		exit(1)
	}
	cfg["api_port"] := dict_get_or(port_result, "value", dict_get_or(cfg, "api_port", 8787))
	if has_key(flags, "host") == 1 {
		cfg["api_host"] := flags["host"]
	}
	start_api_server(cfg)
}

func command_bootstrap(parsed) {
	flags := parsed["flags"]
	target := dict_get_or(flags, "target", "./results/bootstrap_repo")
	result := bootstrap_repository(target)
	print(to_json(result))
}

# Entry point
_ := load_dot_env(".env")
cfg := load_config({})
cfg_diagnostics := validate_config(cfg)
if dict_get_or(cfg_diagnostics, "ok", false) == false {
	print(to_json({
		"ok": false,
		"error": "invalid_configuration",
		"message": "Startup configuration validation failed",
		"diagnostics": cfg_diagnostics
	}))
	exit(1)
}
_ = ensure_runtime_dirs(cfg)

parsed := parse_cli(args())
command := to_lower(dict_get_or(parsed, "command", "help"))

if command == "ingest" {
	command_ingest(parsed, cfg)
} else if command == "query" {
	command_query(parsed, cfg)
} else if command == "serve" {
	command_serve(parsed, cfg)
} else if command == "demo" {
	command_demo(cfg)
} else if command == "bootstrap" {
	command_bootstrap(parsed)
} else {
	print_help()
}
