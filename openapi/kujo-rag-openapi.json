			"post": {
				"operationId": "postDrainStop",
				"summary": "Disable drain mode",
				"responses": {
					"200": {
						"description": "Drain stop response",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ApiSuccessEnvelope"
								}
							}
						}
					},
					"default": {
						"$ref": "#/components/responses/ApiError"
					}
				}
			}
		}
	},
	"components": {
		"schemas": {
			"ApiSuccessEnvelope": {
				"type": "object",
				"required": ["ok", "data", "request_id", "correlation_id"],
				"properties": {
					"ok": {"type": "boolean", "enum": [true]},
					"data": {"type": "object"},
					"request_id": {"type": "string"},
					"correlation_id": {"type": "string"}
				}
			},
			"ApiError": {
				"type": "object",
				"required": ["code", "message"],
				"properties": {
					"code": {"type": "string"},
					"message": {"type": "string"},
					"details": {"type": "object"}
				}
			},
			"ApiErrorEnvelope": {
				"type": "object",
				"required": ["ok", "error", "request_id", "correlation_id"],
				"properties": {
					"ok": {"type": "boolean", "enum": [false]},
					"error": {"$ref": "#/components/schemas/ApiError"},
					"request_id": {"type": "string"},
					"correlation_id": {"type": "string"}
				}
			},
			"NamespaceRequest": {
				"type": "object",
				"properties": {
					"namespace": {"type": "string", "minLength": 1}
				}
			},
			"ReasonRequest": {
				"type": "object",
				"properties": {
					"reason": {"type": "string"}
				}
			},
			"ReasonedNamespaceRequest": {
				"allOf": [
					{"$ref": "#/components/schemas/NamespaceRequest"},
					{"$ref": "#/components/schemas/ReasonRequest"}
				]
			},
			"IngestRequest": {
				"allOf": [
					{"$ref": "#/components/schemas/NamespaceRequest"},
					{
						"type": "object",
						"required": ["path"],
						"properties": {
							"path": {"type": "string"},
							"recursive": {"type": "boolean"}
						}
					}
				]
			},
			"IngestJobStatusRequest": {
				"type": "object",
				"required": ["job_id"],
				"properties": {
					"job_id": {"type": "string", "minLength": 1}
				}
			},
			"FederationTarget": {
				"type": "object",
				"required": ["namespace"],
				"properties": {
					"namespace": {"type": "string"},
					"weight": {"type": "number"}
				}
			},
			"FederationRequest": {
				"type": "object",
				"required": ["targets"],
				"properties": {
					"merge_strategy": {"type": "string", "enum": ["weighted_score"]},
					"fallback_policy": {"type": "string", "enum": ["best_effort", "primary_then_all"]},
					"targets": {
						"type": "array",
						"minItems": 1,
						"items": {"$ref": "#/components/schemas/FederationTarget"}
					}
				}
			},
			"ResponsePolicyRequest": {
				"type": "object",
				"properties": {
					"style": {"type": "string", "enum": ["strict_extractive", "concise", "expanded"]},
					"safety_mode": {"type": "string", "enum": ["balanced", "strict", "permissive"]},
					"min_confidence": {"type": "number"},
					"min_citations": {"type": "number"}
				}
			},
			"QueryRequest": {
				"allOf": [
					{"$ref": "#/components/schemas/NamespaceRequest"},
					{
						"type": "object",
						"required": ["query"],
						"properties": {
							"query": {"type": "string", "minLength": 1},
							"filters": {"type": "object"},
							"session_id": {"type": "string"},
							"include_retrieval_explanation": {"type": "boolean"},
							"federation": {"$ref": "#/components/schemas/FederationRequest"},
							"response_policy": {"$ref": "#/components/schemas/ResponsePolicyRequest"}
						}
					}
				]
			},
			"RetentionPolicyRequest": {
				"allOf": [
					{"$ref": "#/components/schemas/NamespaceRequest"},
					{
						"type": "object",
						"properties": {
							"enabled": {"type": "boolean"},
							"ttl_days": {"type": "number"}
						}
					}
				]
			},
			"PrivacyExportRequest": {
				"allOf": [
					{"$ref": "#/components/schemas/NamespaceRequest"},
					{
						"type": "object",
						"properties": {
							"export_type": {"type": "string"}
						}
					}
				]
			}
		},
		"responses": {
			"ApiError": {
				"description": "Error response",
				"content": {
					"application/json": {
						"schema": {
							"$ref": "#/components/schemas/ApiErrorEnvelope"
						}
					}
				}
			}
		}
	}
}
