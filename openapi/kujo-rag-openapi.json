					"200": {
						"description": "Root summary response",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ApiSuccessEnvelope"
								}
							}
						}
					},
					"default": {
						"$ref": "#/components/responses/ApiError"
					}
