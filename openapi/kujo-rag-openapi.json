		"/privacy/delete": {
			"post": {
				"operationId": "postPrivacyDelete",
				"summary": "Run privacy delete workflow",
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/ReasonedNamespaceRequest"
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "Privacy delete response",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ApiSuccessEnvelope"
								}
							}
						}
					},
					"409": {
						"$ref": "#/components/responses/ApiError"
					},
					"default": {
						"$ref": "#/components/responses/ApiError"
					}
				}
			}
		},
		"/drain": {
			"get": {
				"operationId": "getDrain",
				"summary": "Get drain mode state",
				"responses": {
					"200": {
						"description": "Drain state response",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ApiSuccessEnvelope"
								}
							}
						}
					},
					"default": {
						"$ref": "#/components/responses/ApiError"
					}
				}
			}
		},
		"/drain/start": {
			"post": {
				"operationId": "postDrainStart",
				"summary": "Enable drain mode",
				"requestBody": {
					"required": false,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/ReasonRequest"
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "Drain start response",
						"content": {
