{
	"openapi": "3.0.3",
	"info": {
		"title": "Kujo RAG HTTP API",
		"version": "1.0.0",
		"description": "Contract for the Kujo RAG HTTP service endpoints.",
		"x-kujo-rag-api-version": "v1"
	},
	"servers": [
		{
			"url": "http://127.0.0.1:8787",
			"description": "Local default"
